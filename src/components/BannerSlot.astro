---
// Slot de banner afiliat. Folosire:
//   <BannerSlot category="parfumuri" size="728x90" />   → banner orizontal (728x90 sau 468x60)
//   <BannerSlot category="homepage" />                  → orice banner de site (orizontal, 300x250, 300x300, 750x350, 600x250)
//
// - category: slug-ul categoriei curente (sau "homepage")
// - size (optional): "728x90" = slot orizontal; lipsa = orice dimensiune de site
//
// Pe site apar DOAR bannerele care au "site" in channels si au una dintre
// dimensiunile de mai jos — formatele mari (300x600, 1080x1080, 750x350 etc.)
// raman pentru email / social media si nu mai incarca pagina.
//
// Filtrarea dupa data (active_from / active_until) si alegerea aleatorie se
// fac CLIENT-SIDE (in browser), nu la build - altfel un banner expirat ar
// ramane afisat pana la urmatorul rebuild al site-ului, iar rotatia aleatorie
// la fiecare incarcare n-ar fi posibila pe un site static.
import { banners } from '../data/banners.js';

const { category, size = null } = Astro.props;

const ORIZONTALE = ['728x90', '468x60'];
const PE_SITE = [...ORIZONTALE, '300x250', '300x300', '750x350', '600x250']; // cele late apar doar in slotul de jos
const MAX_H = 250; // inaltimea maxima a unui banner pe site (px)

const eligible = banners.filter((b) => {
  const dim = `${b.width}x${b.height}`;
  if (!b.categories.includes(category)) return false;
  if (!(b.channels || []).includes('site')) return false;
  if (!PE_SITE.includes(dim)) return false;
  if (size === '728x90' && !ORIZONTALE.includes(dim)) return false;
  if (size && size !== '728x90' && dim !== size) return false;
  return true;
});
---
{eligible.length > 0 && (
  <div class="banner-slot" data-banner-slot>
    {eligible.map((b) => (
      <a
        class="banner-item"
        href={b.affiliate_url}
        target="_blank"
        rel="noopener sponsored nofollow"
        data-banner-id={b.id}
        data-active-from={b.active_from || ''}
        data-active-until={b.active_until || ''}
        style={`max-width:${b.width}px`}
        hidden
      >
        <img src={b.image_url} alt={b.merchant} width={b.width} height={b.height} loading="lazy"
             style={`width:min(100%, ${Math.min(b.width, Math.round(MAX_H * b.width / b.height))}px)`} />
      </a>
    ))}
  </div>
)}

<script>
  // Ruleaza pentru toate sloturile de pe pagina: filtreaza dupa data curenta,
  // alege un banner aleatoriu dintre cele active si il face vizibil.
  document.querySelectorAll('[data-banner-slot]').forEach((slot) => {
    const today = new Date().toISOString().slice(0, 10); // YYYY-MM-DD
    const candidates = Array.from(slot.querySelectorAll('.banner-item')).filter((el) => {
      const from = el.dataset.activeFrom;
      const until = el.dataset.activeUntil;
      if (from && today < from) return false;
      if (until && today > until) return false;
      return true;
    });
    if (candidates.length === 0) {
      slot.remove(); // niciun banner activ azi - slotul dispare complet
      return;
    }
    // nu repetam acelasi banner in doua sloturi de pe aceeasi pagina (daca avem de unde alege)
    const used = (window.__bhBannere ||= new Set());
    const fresh = candidates.filter((el) => !used.has(el.dataset.bannerId));
    const pool = fresh.length ? fresh : candidates;
    const pick = pool[Math.floor(Math.random() * pool.length)];
    used.add(pick.dataset.bannerId);
    pick.hidden = false;
  });
</script>

<style>
  .banner-slot {
    display: flex;
    justify-content: center;
    margin: 20px 0;
  }
  .banner-item { display: block; width: 100%; }
  .banner-item img {
    display: block;
    height: auto;             /* latimea vine din atributul style: maxim 250px inaltime */
    margin: 0 auto;
    border-radius: 6px;
  }
  .banner-item[hidden] {
    display: none;
  }
</style>
