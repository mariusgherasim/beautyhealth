---
// Cautarea din pagina de categorie + fereastra de sugestii.
//
// La click in casuta (sau pe lupa), cand casuta e goala, apare imediat sub ea o
// fereastra cu 6 Tipuri si 6 Branduri alese aleator. Hover (desktop) sau atingere
// (mobil) pe un tip/brand afiseaza alaturi 8 produse aleatorii din el.
// Fereastra nu ia cursorul din casuta: de la primul caracter scris se inchide si
// apar rezultatele normale ale cautarii; daca stergi tot textul, reapare.
import '../styles/search-panel.css';
const { categorySlug, categoryName } = Astro.props;
---
<div class="cs-wrap">
  <div class="category-search" data-category={categorySlug}>
    <input
      type="text"
      class="search-input"
      placeholder={`Caută în ${categoryName} (ex: brand sau denumire produs)...`}
      autocomplete="off"
      aria-haspopup="dialog"
      aria-expanded="false"
    />
    <button type="button" class="search-icon" aria-label="Deschide sugestiile de căutare">🔍</button>
    <p class="search-status"></p>
  </div>

  <div class="sp-panel" hidden role="dialog" aria-label={`Sugestii în ${categoryName}`}>
    <div class="sp-side">
      <div class="sp-block">
        <p class="sp-heading">Tipuri populare</p>
        <div class="sp-tipuri"></div>
      </div>
      <div class="sp-block">
        <p class="sp-heading">Branduri populare</p>
        <div class="sp-branduri"></div>
      </div>
    </div>
    <div class="sp-main">
      <div class="sp-main-head">
        <p class="sp-heading sp-titlu">Produse populare</p>
        <a class="sp-vezi" href="#">Vezi toate →</a>
        <button type="button" class="sp-close" aria-label="Închide">✕</button>
      </div>
      <div class="sp-produse"></div>
    </div>
  </div>
</div>

<div class="search-results grid" hidden></div>

<script>
  // Normalizeaza diacritice (ă,â,î,ș,ț -> a,a,i,s,t) ca "sanatate" sa gaseasca "sănătate" si invers.
  function normalize(str) {
    return str
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .toLowerCase();
  }

  function debounce(fn, delay) {
    let t;
    return (...args) => {
      clearTimeout(t);
      t = setTimeout(() => fn(...args), delay);
    };
  }

  function escapeHtml(s) {
    const div = document.createElement('div');
    div.textContent = s == null ? '' : String(s);
    return div.innerHTML;
  }

  function shuffle(arr) {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function renderCard(p) {
    const hasDiscount = p.old_price && p.old_price > p.price;
    const img = p.image_url
      ? `<img src="${escapeHtml(p.image_url)}" alt="${escapeHtml(p.title)}" loading="lazy" width="220" height="220" />`
      : '';
    return `
      <a class="product-card" href="${escapeHtml(p.affiliate_url)}" target="_blank" rel="noopener sponsored nofollow"
         data-product-id="${escapeHtml(p.id)}" data-product-title="${escapeHtml(p.title)}" data-product-price="${p.price}">
        ${hasDiscount ? '<span class="badge">Ofertă</span>' : ''}
        ${img}
        <div class="card-body">
          ${p.brand ? `<span class="brand">${escapeHtml(p.brand)}</span>` : ''}
          <h3>${escapeHtml(p.title)}</h3>
          <div class="price-row">
            <span class="price">${Number(p.price).toFixed(2)} RON</span>
            ${hasDiscount ? `<span class="old-price">${Number(p.old_price).toFixed(2)} RON</span>` : ''}
          </div>
          <span class="cta">Vezi oferta →</span>
        </div>
      </a>`;
  }

  // Card compact pentru fereastra de sugestii
  function renderMini(p) {
    const disc = p.op && p.op > p.pr;
    return `
      <a class="sp-card" href="${escapeHtml(p.u)}" target="_blank" rel="noopener sponsored nofollow"
         data-product-id="${escapeHtml(p.id)}" data-product-title="${escapeHtml(p.t)}" data-product-price="${p.pr}">
        <span class="sp-img"><img src="${escapeHtml(p.img)}" alt="${escapeHtml(p.t)}" loading="lazy" width="140" height="140" /></span>
        <span class="sp-name">${escapeHtml(p.t)}</span>
        <span class="sp-price">${Number(p.pr).toFixed(2)} RON${disc ? ` <s>${Number(p.op).toFixed(2)}</s>` : ''}</span>
      </a>`;
  }

  document.querySelectorAll('.cs-wrap').forEach((wrap) => {
    const box = wrap.querySelector('.category-search');
    const slug = box.dataset.category;
    const input = box.querySelector('.search-input');
    const lupa = box.querySelector('.search-icon');
    const status = box.querySelector('.search-status');
    const resultsEl = wrap.parentElement.querySelector('.search-results');
    // elementele normale ale paginii (titlu rezultate + grid paginat + paginare)
    const normalView = document.querySelectorAll('.results-count, .grid.paginated, .pagination');

    const panel = wrap.querySelector('.sp-panel');
    const elTipuri = panel.querySelector('.sp-tipuri');
    const elBranduri = panel.querySelector('.sp-branduri');
    const elProduse = panel.querySelector('.sp-produse');
    const elTitlu = panel.querySelector('.sp-titlu');
    const elVezi = panel.querySelector('.sp-vezi');

    // ── Fereastra de sugestii ───────────────────────────────────────────
    let panelData = null;
    let panelLoading = null;
    let grupuri = {}; // key -> grup (tip sau brand)

    function loadPanel() {
      if (panelData) return Promise.resolve(panelData);
      if (!panelLoading) {
        panelLoading = fetch(`/search-panel/${slug}.json`)
          .then((r) => r.json())
          .then((d) => (panelData = d))
          .catch(() => (panelData = { tipuri: [], branduri: [] }));
      }
      return panelLoading;
    }

    function arataProduse(key) {
      const g = grupuri[key];
      if (!g) return;
      panel.querySelectorAll('.sp-item').forEach((el) => el.classList.toggle('active', el.dataset.key === key));
      elTitlu.textContent = g.name;
      elVezi.href = g.url;
      elVezi.textContent = `Vezi toate ${g.count} →`;
      elProduse.innerHTML = shuffle(g.p).slice(0, 8).map(renderMini).join('');
    }

    function construiestePanel() {
      const tipuri = shuffle(panelData.tipuri).slice(0, 6);
      const branduri = shuffle(panelData.branduri).slice(0, 6);
      grupuri = {};
      tipuri.forEach((g) => (grupuri['t:' + g.slug] = g));
      branduri.forEach((g) => (grupuri['b:' + g.slug] = g));

      elTipuri.innerHTML = tipuri
        .map((g) => `<button type="button" class="sp-item sp-tip" data-key="t:${escapeHtml(g.slug)}">${escapeHtml(g.name)}</button>`)
        .join('');
      elBranduri.innerHTML = branduri
        .map((g) => `<button type="button" class="sp-item sp-brand" data-key="b:${escapeHtml(g.slug)}" title="${escapeHtml(g.name)}">${
          g.logo ? `<img src="${escapeHtml(g.logo)}" alt="${escapeHtml(g.name)}" loading="lazy" />` : `<span>${escapeHtml(g.name)}</span>`
        }</button>`)
        .join('');
      panel.querySelector('.sp-branduri').closest('.sp-block').hidden = branduri.length === 0;
      panel.querySelector('.sp-tipuri').closest('.sp-block').hidden = tipuri.length === 0;

      const primul = tipuri[0] ? 't:' + tipuri[0].slug : branduri[0] ? 'b:' + branduri[0].slug : null;
      if (primul) arataProduse(primul);
      else elProduse.innerHTML = '';
    }

    let deschidere = false;
    async function deschide() {
      if (input.value.trim() !== '' || !panel.hidden || deschidere) return;
      deschidere = true;
      await loadPanel();
      deschidere = false;
      if (input.value.trim() !== '') return; // a inceput sa scrie intre timp
      if (!panelData.tipuri.length && !panelData.branduri.length) return;
      construiestePanel();
      panel.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      if (typeof gtag === 'function') gtag('event', 'bh_search_panel_open', { category: slug });
    }

    function inchide() {
      if (panel.hidden) return;
      panel.hidden = true;
      input.setAttribute('aria-expanded', 'false');
    }

    input.addEventListener('focus', deschide);
    input.addEventListener('click', deschide);
    lupa.addEventListener('click', () => { input.focus(); deschide(); });
    panel.querySelector('.sp-close').addEventListener('click', inchide);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') inchide(); });
    document.addEventListener('click', (e) => { if (!wrap.contains(e.target)) inchide(); });

    // Butoanele din fereastra nu iau cursorul din casuta (poti scrie oricand)
    panel.addEventListener('mousedown', (e) => {
      if (e.target.closest('button')) e.preventDefault();
    });

    // Hover pe desktop, atingere/click oriunde
    const canHover = window.matchMedia('(hover: hover)').matches;
    panel.addEventListener('mouseover', (e) => {
      if (!canHover) return;
      const it = e.target.closest('.sp-item');
      if (it && !it.classList.contains('active')) arataProduse(it.dataset.key);
    });
    panel.addEventListener('click', (e) => {
      const it = e.target.closest('.sp-item');
      if (it) arataProduse(it.dataset.key);
      const card = e.target.closest('.sp-card');
      if (card && typeof gtag === 'function') {
        gtag('event', 'bh_affiliate_click', {
          product_id: card.dataset.productId || '',
          product_title: card.dataset.productTitle || '',
          product_price: card.dataset.productPrice || '',
          source: 'search_panel',
          page_location: window.location.href,
        });
      }
    });

    // ── Cautarea normala ────────────────────────────────────────────────
    let allProducts = null;
    let loading = false;

    async function ensureLoaded() {
      if (allProducts || loading) return;
      loading = true;
      status.textContent = 'Se încarcă produsele din categorie...';
      try {
        const res = await fetch(`/category-data/${slug}.json`);
        allProducts = await res.json();
      } catch (e) {
        allProducts = [];
        status.textContent = 'Căutarea nu a putut fi încărcată. Încearcă din nou.';
      }
      loading = false;
    }

    const runSearch = debounce(async (query) => {
      const q = query.trim();
      if (q.length === 0) {
        resultsEl.hidden = true;
        normalView.forEach((el) => (el.style.display = ''));
        status.textContent = '';
        return;
      }

      await ensureLoaded();
      if (input.value.trim() === '') return;
      normalView.forEach((el) => (el.style.display = 'none'));
      resultsEl.hidden = false;

      // Toate cuvintele cautate trebuie sa apara in denumire sau brand (ca pe prima pagina)
      const cuvinte = normalize(q).split(/\s+/).filter(Boolean);
      const matches = allProducts.filter((p) => {
        const text = normalize(p.title + ' ' + (p.brand || ''));
        return cuvinte.every((w) => text.includes(w));
      });

      status.textContent = `${matches.length} produse găsite pentru "${q}"`;
      resultsEl.innerHTML = matches.length
        ? matches.slice(0, 200).map(renderCard).join('')
        : `<div class="search-empty">Niciun produs găsit pentru "${escapeHtml(q)}". Încearcă alt termen.</div>`;

      // Baner intre rezultate: clonam un banner ACTIV din sloturile deja
      // randate pe pagina si il inseram dupa al 12-lea rezultat.
      if (matches.length > 0) {
        const activeBanners = Array.from(
          document.querySelectorAll('[data-banner-slot] .banner-item:not([hidden])')
        );
        if (activeBanners.length > 0) {
          const pick = activeBanners[Math.floor(Math.random() * activeBanners.length)].cloneNode(true);
          pick.classList.add('banner-in-results');
          const cards = resultsEl.querySelectorAll('.product-card');
          const anchor = cards[Math.min(11, cards.length - 1)];
          anchor.insertAdjacentElement('afterend', pick);
        }
      }

      if (matches.length > 200) {
        status.textContent += ` (afișate primele 200)`;
      }
    }, 250);

    // Cautare venita din prima pagina: /categorie/?q=termen
    const qInit = new URLSearchParams(location.search).get('q');
    if (qInit) {
      input.value = qInit;
      runSearch(qInit);
      setTimeout(() => wrap.scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
    }

    input.addEventListener('input', (e) => {
      const v = e.target.value;
      if (v.trim() === '') {
        runSearch(v);
        deschide(); // a sters tot textul -> fereastra reapare
      } else {
        inchide(); // primul caracter scris -> fereastra se inchide
        runSearch(v);
      }
    });
  });
</script>
