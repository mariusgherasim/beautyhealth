---
import fs from 'node:fs';
// Pictograma SAL (ANPC): apare singură când există fișierul public/images/anpc-sal.png
// (pictograma oficială de pe anpc.ro/download/sal/, colțurile făcute transparente pentru fundalul închis). SOL nu se mai pune (desființată, Ordinul ANPC 270/2026).
const areSAL = fs.existsSync('public/images/anpc-sal.png');
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="col">
      <strong>BeautyHealth</strong>
      <p>Comparator de prețuri pentru produse de frumusețe, îngrijire și sănătate. Linkurile de pe acest site sunt linkuri de afiliere — putem primi un comision din vânzările generate, fără costuri suplimentare pentru tine.</p>
    </div>
    <div class="col">
      <strong>Legal</strong>
      <a href="/politica-de-confidentialitate/">Politica de confidențialitate</a>
      <a href="/termeni-si-conditii/">Termeni și condiții</a>
    </div>
    <div class="col">
      <strong>Ghiduri</strong>
      <a href="/ghiduri/">Toate ghidurile</a>
      <a href="/ghiduri/note-parfum-varf-inima-baza/">Note de vârf, inimă și bază</a>
      <a href="/ghiduri/parfum-edp-edt/">Parfum, EDP sau EDT?</a>
      <a href="/promotii/">Promoții și coduri</a>
    </div>
    <div class="col">
      <strong>Alte proiecte</strong>
      <a href="https://gherasimmarius.com" target="_blank" rel="noopener">gherasimmarius.com</a>
      <a href="https://styleaccessories.eu" target="_blank" rel="noopener">Style Accessories — Ceasuri, Bijuterii &amp; Încălțăminte</a>
      <a href="https://carti.gherasimmarius.com" target="_blank" rel="noopener">Cărți — ÎncăUnCapitol</a>
      <a href="https://copywriting.gherasimmarius.com" target="_blank" rel="noopener">Copywriting &amp; Marketing</a>
    </div>
  </div>
  <div class="footer-badges">
    <a class="bl-partner" href="https://businessleague.com/" target="_blank" rel="noopener">
      <img src="/images/businessleague-logo.png" alt="BusinessLeague" width="109" height="32" loading="lazy" decoding="async" />
      <span>Affiliate Marketing Partner</span>
    </a>
    {areSAL && (
      <a class="sal-anpc" href="https://reclamatiisal.anpc.ro/" target="_blank" rel="noopener noreferrer">
        <img src="/images/anpc-sal.png" alt="ANPC — Soluționarea alternativă a litigiilor" width="250" height="62" loading="lazy" decoding="async" />
      </a>
    )}
  </div>
  <div class="bottom-bar">
    <span>© {new Date().getFullYear()} BeautyHealth · gherasimmarius.com</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: #d8d8d8;
    margin-top: 40px;
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 36px 16px;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 24px;
  }
  .col strong { color: #fff; display: block; margin-bottom: 10px; }
  .col a { display: block; color: #cfcfcf; text-decoration: none; font-size: 0.88rem; margin-bottom: 6px; }
  .col a:hover { color: var(--gold); }
  .col p { font-size: 0.82rem; line-height: 1.5; color: #b8b8b8; }
  .footer-badges {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }
  .bl-partner {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 6px 12px; background: #12131f; color: #fff;
    border: 1px solid rgba(255,255,255,0.12); border-radius: 8px;
    font-size: 12px; font-weight: 600; text-decoration: none; line-height: 1;
  }
  .bl-partner:hover { border-color: rgba(167,139,250,0.6); }
  .bl-partner img { display: block; height: 32px; width: auto; }
  .sal-anpc img { display: block; width: 250px; height: auto; max-width: 100%; }
  .bottom-bar {
    border-top: 1px solid rgba(255,255,255,0.1);
    text-align: center;
    padding: 14px;
    font-size: 0.78rem;
    color: #999;
  }
  @media (max-width: 720px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
