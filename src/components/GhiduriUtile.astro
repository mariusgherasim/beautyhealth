---
// Blocul „Ghiduri utile" de pe paginile de categorie (date: src/data/ghiduri.js)
import { ghiduriPentru, ghiduriSortate } from '../data/ghiduri.js';
const { categorie = null, toate = false, titlu = 'Ghiduri utile' } = Astro.props;
const lista = toate ? ghiduriSortate() : categorie ? ghiduriPentru(categorie) : [];
---
{lista.length > 0 && (
  <section class="gh-bloc" aria-label={titlu}>
    <div class="gh-head"><h2>📖 {titlu}</h2>{!toate && <a href="/ghiduri/">Toate ghidurile →</a>}</div>
    <div class="gh-grid">
      {lista.map((g) => (
        <a class="gh-card" href={`/ghiduri/${g.slug}/`}>
          <span class="gh-emoji" aria-hidden="true">{g.emoji}</span>
          <span class="gh-meta">{g.eticheta} · {g.minute} min de citit</span>
          <span class="gh-titlu">{g.titlu}</span>
          <span class="gh-desc">{g.descriere}</span>
          <span class="gh-cta">Citește ghidul →</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .gh-bloc { margin: 32px 0 20px; }
  .gh-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; border-bottom: 1px solid #e3e3e8; padding-bottom: 8px; margin-bottom: 14px; }
  .gh-head h2 { margin: 0; font-size: 1.35rem; color: var(--navy, #0b1f4a); }
  .gh-head a { font-size: .85rem; font-weight: 700; color: var(--gold, #c89b3c); text-decoration: none; }
  .gh-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 14px; }
  .gh-card { display: flex; flex-direction: column; gap: 6px; background: #fff; border: 1px solid #e3e3e8; border-top: 3px solid var(--gold, #c89b3c); border-radius: 12px; padding: 16px; text-decoration: none; color: inherit; transition: transform .15s, box-shadow .15s; }
  .gh-card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(11,31,74,.12); }
  .gh-emoji { font-size: 1.6rem; line-height: 1; }
  .gh-meta { font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--gold, #c89b3c); }
  .gh-titlu { font-family: Georgia, serif; font-size: 1.12rem; font-weight: 700; color: var(--navy, #0b1f4a); line-height: 1.3; }
  .gh-desc { font-size: .9rem; color: #555; line-height: 1.5; }
  .gh-cta { margin-top: auto; padding-top: 4px; font-size: .85rem; font-weight: 700; color: var(--navy, #0b1f4a); }
</style>
