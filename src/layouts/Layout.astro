    <script is:inline>
      (function () {
        var of = document.getElementById('of-tab'), pr = document.getElementById('pr-tab');
        // numărul de pe tabul Promoții: doar ofertele active azi (unele sunt programate cu „incepe")
        if (pr && pr.dataset.promo) {
          var azi = new Date(Date.now() + 2 * 3600e3).toISOString().slice(0, 10);
          var nr = JSON.parse(pr.dataset.promo).filter(function (d) { return (!d[0] || d[0] <= azi) && (!d[1] || d[1] >= azi); }).length;
          if (!nr) { pr.style.setProperty('display', 'none', 'important'); pr = null; }
          else { var sp = pr.querySelector('.pr-tab-nr'); if (sp) sp.textContent = nr; }
        }
        // pe paginile de oferte nu arătăm tabul de oferte
        if (of && location.pathname.indexOf('/oferte/') === 0) { of.style.setProperty('display', 'none', 'important'); of = null; }
        if (!of || !pr || location.pathname.indexOf('/promotii/') === 0) return;
        var h = document.documentElement, mob = window.matchMedia('(max-width: 640px)');
        h.classList.add('tab-alt', 'tab-of');
        setInterval(function () {
          if (!mob.matches) return;
          var arataOf = h.classList.contains('tab-pr');
          h.classList.toggle('tab-of', arataOf); h.classList.toggle('tab-pr', !arataOf);
        }, 2000);
      })();
