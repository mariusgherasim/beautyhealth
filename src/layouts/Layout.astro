          <li><b>Moderat</b> 4 sucuri + 1 salată</li>
          <li><b>Ușor</b> 3 sucuri + 2 salate</li>
        </ul>
      </div>
      <div class="dxs-cta">
        Alege programul
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
      <button class="dxs-close" id="dxs-close" title="Închide" aria-label="Închide">✕</button>
    </a>
    <style is:global>
      .dx-sticker {
        position: fixed; bottom: 24px; right: 24px; z-index: 9999;
        width: 178px; background: #12341f; color: #fff;
        border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,.28), 0 2px 8px rgba(185,224,122,.25);
        overflow: hidden; text-decoration: none;
        transition: transform .2s, box-shadow .2s;
        font-family: 'Segoe UI', system-ui, sans-serif;
      }
      .dx-sticker:hover { transform: translateY(-3px); box-shadow: 0 12px 40px rgba(0,0,0,.32), 0 4px 16px rgba(185,224,122,.35); }
      .dxs-top { background: #b9e07a; padding: 10px 32px 8px 14px; display: flex; align-items: center; justify-content: space-between; }
      .dxs-big { font-size: 1.5rem; font-weight: 900; line-height: 1; font-family: Georgia, serif; color: #12341f; }
      .dxs-label { font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .09em; text-align: right; line-height: 1.35; color: #12341f; }
      .dxs-mid { padding: 10px 14px 8px; }
      .dxs-brand { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #b9e07a; margin-bottom: 3px; }
      .dxs-desc { font-size: .78rem; color: rgba(255,255,255,.82); line-height: 1.4; margin-bottom: 6px; }
      .dxs-list { list-style: none; margin: 0; padding: 0; font-size: .72rem; color: rgba(255,255,255,.75); line-height: 1.55; }
      .dxs-list b { color: #fff; }
      .dxs-cta { background: #2f8f4e; text-align: center; padding: 9px 14px; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; display: flex; align-items: center; justify-content: center; gap: 5px; color: #fff; }
