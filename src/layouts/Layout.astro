---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = "/og-default.jpg",
} = Astro.props;

import { promotii } from "../data/promotii.js";
const aziBuild = new Date().toISOString().slice(0, 10);
// promoțiile care nu au expirat (inclusiv cele programate, cu „incepe" în viitor) — browserul le numără pe cele de azi
const promoNeexpirate = promotii.filter((p) => !p.expira || p.expira >= aziBuild);
const nrPromotii = promoNeexpirate.filter((p) => !p.incepe || p.incepe <= aziBuild).length;
const datePromo = JSON.stringify(promoNeexpirate.map((p) => [p.incepe || '', p.expira || '']));
import { oferte } from "../data/catalog.mjs";
const nrOferte = oferte().length;
const siteName = "BeautyHealth";
const absoluteOgImage = new URL(ogImage, "https://beauty-healths.com").href;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google tag (gtag.js) -->
    <!-- gtag.js (197 KB) se încarcă după afișarea paginii sau la prima atingere/derulare.
         Evenimentele de până atunci stau în dataLayer și se trimit, nu se pierd. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-HS59YL4Y3D');
      (function () {
        var done = false;
        function loadGA() {
          if (done) return; done = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-HS59YL4Y3D';
          document.head.appendChild(s);
        }
        ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (e) {
          window.addEventListener(e, loadGA, { once: true, passive: true });
        });
        window.addEventListener('load', function () { setTimeout(loadGA, 1500); });
      })();
    </script>

    <!-- TrustBox script — se încarcă după ce pagina e afișată, ca să nu încetinească site-ul pe mobil -->
    <script is:inline>
      window.addEventListener('load', function () {
        setTimeout(function () {
          var s = document.createElement('script');
          s.src = 'https://widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js';
          s.async = true;
          document.head.appendChild(s);
        }, 1200);
      });
    </script>
    <!-- End TrustBox script -->

    <slot name="head" />
  </head>
  <body>
    <slot />

    <script is:inline>
      // bh_affiliate_click - delegare globala, functioneaza atat pentru cardurile
      // randate de Astro (paginare normala) cat si pentru cele injectate de JS
      // (rezultate cautare), pentru ca ambele au aceleasi data-attributes.
      document.addEventListener('click', function (e) {
        var card = e.target.closest('.product-card');
        if (!card) return;
        if (typeof gtag !== 'function') return;
        gtag('event', 'bh_affiliate_click', {
          product_id: card.dataset.productId || '',
          product_title: card.dataset.productTitle || '',
          product_price: card.dataset.productPrice || '',
          page_location: window.location.href,
        });
      });
    </script>

    <!-- ── PROMO STICKER: Farmec 30% — 14 Oct–1 Nov 2026 ── -->
    <a class="promo-sticker" id="promo-sticker"
       href="https://event.2performant.com/events/click?ad_type=quicklink&aff_code=676a7e7d9&unique=1dfbc028f&redirect_to=https%253A//www.farmec.ro/promo/complete-care"
       target="_blank" rel="noopener sponsored">
      <div class="ps-top">
        <span class="ps-pct">30%</span>
        <span class="ps-label">Reducere<br>îngrijire ten</span>
      </div>
      <div class="ps-mid">
        <div class="ps-brand">Farmec</div>
        <div class="ps-desc">Complete Care — reducere directă în preț</div>
      </div>
      <div class="ps-timer">
        <div class="ps-block"><span class="ps-num" id="ps-d">17</span><span class="ps-lbl">Zile</span></div>
        <span class="ps-sep">:</span>
        <div class="ps-block"><span class="ps-num" id="ps-h">00</span><span class="ps-lbl">Ore</span></div>
        <span class="ps-sep">:</span>
        <div class="ps-block"><span class="ps-num" id="ps-m">00</span><span class="ps-lbl">Min</span></div>
        <span class="ps-sep ps-sec">:</span>
        <div class="ps-block ps-sec"><span class="ps-num" id="ps-s">00</span><span class="ps-lbl">Sec</span></div>
      </div>
      <div class="ps-cta">
        Vezi oferta
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
      <button class="ps-close" id="ps-close" title="Închide" aria-label="Închide">✕</button>
    </a>

    <!-- ── TOMBOLA STICKER: Farmec 15 ani — 5 Oct–18 Nov 2026 ── -->
    <a class="tombola-sticker" id="tombola-sticker" href="/farmec-15-ani.html">
      <div class="ts-top">
        <span class="ts-big">15</span>
        <span class="ts-label">Ani<br>aniversare</span>
      </div>
      <div class="ts-mid">
        <div class="ts-brand">Farmec · Tombola</div>
        <div class="ts-desc">Premii aniversare pe farmec.ro și în magazinele Gerovital</div>
      </div>
      <div class="ts-timer">
        <div class="ts-block"><span class="ts-num" id="ts-d">--</span><span class="ts-lbl">Zile</span></div>
        <span class="ts-sep">:</span>
        <div class="ts-block"><span class="ts-num" id="ts-h">--</span><span class="ts-lbl">Ore</span></div>
        <span class="ts-sep">:</span>
        <div class="ts-block"><span class="ts-num" id="ts-m">--</span><span class="ts-lbl">Min</span></div>
      </div>
      <div class="ts-cta">
        Vezi cum participi
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
      <button class="ts-close" id="ts-close" title="Închide" aria-label="Închide">✕</button>
    </a>
    <style is:global>
      .tombola-sticker {
        position: fixed; bottom: 24px; left: 24px; z-index: 9999;
        width: 178px; background: #0B1F4A; color: #fff;
        border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,.28), 0 2px 8px rgba(200,155,60,.25);
        overflow: hidden; text-decoration: none; display: block;
        transition: transform .2s, box-shadow .2s;
        font-family: 'Segoe UI', system-ui, sans-serif;
      }
      .tombola-sticker:hover { transform: translateY(-3px); box-shadow: 0 12px 40px rgba(0,0,0,.32), 0 4px 16px rgba(200,155,60,.35); }
      .ts-top { background: #C89B3C; padding: 10px 32px 8px 14px; display: flex; align-items: center; justify-content: space-between; }
      .ts-big { font-size: 1.9rem; font-weight: 900; line-height: 1; font-family: Georgia, serif; color: #1a1713; }
      .ts-label { font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .09em; text-align: right; line-height: 1.35; color: #1a1713; }
      .ts-mid { padding: 10px 14px 6px; border-bottom: 1px solid rgba(255,255,255,.1); }
      .ts-brand { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #C89B3C; margin-bottom: 3px; }
      .ts-desc { font-size: .78rem; color: rgba(255,255,255,.8); line-height: 1.4; }
      .ts-timer { padding: 8px 14px; display: flex; gap: 6px; justify-content: center; align-items: center; }
      .ts-block { display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,.08); border-radius: 5px; padding: 4px 6px; min-width: 38px; }
      .ts-num { font-size: .9rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1; color: #fff; }
      .ts-lbl { font-size: .48rem; text-transform: uppercase; letter-spacing: .06em; color: rgba(255,255,255,.75); margin-top: 2px; }
      .ts-sep { font-size: .75rem; color: rgba(255,255,255,.3); margin-top: -4px; }
      .ts-cta { background: #c8102e; text-align: center; padding: 9px 14px; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; display: flex; align-items: center; justify-content: center; gap: 5px; color: #fff; }
      .ts-close { position: absolute; top: 4px; right: 4px; width: 26px; height: 26px; background: rgba(0,0,0,.18); border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #1a1713; font-size: 12px; line-height: 1; padding: 0; }
      .ts-close:hover { background: rgba(0,0,0,.3); }
      @media (max-width: 480px) {
        .tombola-sticker { left: 10px; width: 150px; }
        .ts-desc { display: none; }
      }
    </style>
    <script is:inline>
      (function () {
        var el = document.getElementById('tombola-sticker');
        if (!el) return;
        var end = new Date('2026-11-18T23:59:59+02:00');
        // Ascunde doar după finalul campaniei (la fiecare pagină nouă sticker-ul reapare)
        if (new Date() > end) { el.style.display = 'none'; return; }
        // Nu afișa sticker-ul chiar pe pagina campaniei
        if (location.pathname.indexOf('farmec-15-ani') !== -1) { el.style.display = 'none'; return; }

        function pad(n) { return String(n).padStart(2, '0'); }
        function tick() {
          var diff = Math.max(0, end - new Date());
          var d = Math.floor(diff / 86400000); diff %= 86400000;
          var h = Math.floor(diff / 3600000);  diff %= 3600000;
          var m = Math.floor(diff / 60000);
          document.getElementById('ts-d').textContent = pad(d);
          document.getElementById('ts-h').textContent = pad(h);
          document.getElementById('ts-m').textContent = pad(m);
        }
        tick(); setInterval(tick, 30000);

        var btn = document.getElementById('ts-close');
        if (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault(); e.stopPropagation();
            el.style.transition = 'opacity .3s, transform .3s'; el.style.opacity = '0'; el.style.transform = 'translateY(20px)';
            setTimeout(function(){ el.style.display = 'none'; }, 320);
          });
        }
      })();
    </script>
    <!-- ── END TOMBOLA STICKER ── -->

    <!-- ── FARMEC BLACK FRIDAY STICKER: teasing 30 oct, early access 5 nov, până pe 23 nov 2026 ── -->
    <!-- În stânga jos, doar pe paginile cu produse Farmec (Ten, Corp, Păr, Machiaj și paginile brandurilor Farmec/Gerovital/Aslavital).
         Acolo alternează cu stickerul „Farmec 15 ani” (tombola, până pe 18 nov). Duce la /farmec-black-friday/.
         ⚠️ Data de final 23 nov e presupusă (perioada comisionului de 10%) — corecteaz-o aici și în promotii.js dacă Farmec anunță alta. -->
    <a class="fb-sticker" id="fb-sticker" href="/farmec-black-friday/" style="display:none">
      <div class="fbs-top">
        <span class="fbs-big" id="fbs-big">5.11</span>
        <span class="fbs-label" id="fbs-label">Early access<br>BeautyCLUB</span>
      </div>
      <div class="fbs-mid">
        <div class="fbs-brand">Farmec · Black Friday</div>
        <div class="fbs-desc" id="fbs-desc">Membrii BeautyCLUB intră cu o zi înaintea tuturor</div>
        <div class="fbs-cd"><span id="fbs-cdt">Începe în</span><b id="fbs-cd">--</b></div>
      </div>
      <div class="fbs-cta" id="fbs-cta">Cum intri primul →</div>
      <button class="fbs-close" id="fbs-close" title="Închide" aria-label="Închide">✕</button>
    </a>
    <style is:global>
      .fb-sticker {
        position: fixed; bottom: 24px; left: 24px; z-index: 9999;
        width: 178px; background: #111; color: #fff;
        border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,.3), 0 2px 8px rgba(200,16,46,.3);
        overflow: hidden; text-decoration: none; border: 1px solid rgba(214,168,74,.5);
        transition: transform .2s, opacity .45s;
        font-family: 'Segoe UI', system-ui, sans-serif;
      }
      .fb-sticker:hover { transform: translateY(-3px); }
      .fbs-top { background: linear-gradient(135deg, #e9cf86, #c89b3c); padding: 10px 32px 8px 14px; display: flex; align-items: center; justify-content: space-between; color: #111; }
      .fbs-big { font-size: 1.55rem; font-weight: 900; line-height: 1; font-family: Georgia, serif; }
      .fbs-label { font-size: .56rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; text-align: right; line-height: 1.35; }
      .fbs-mid { padding: 9px 14px 8px; }
      .fbs-brand { font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #e9cf86; margin-bottom: 3px; }
      .fbs-desc { font-size: .74rem; color: rgba(255,255,255,.8); line-height: 1.4; margin-bottom: 6px; }
      .fbs-cd { display: flex; flex-direction: column; gap: 1px; font-size: .58rem; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.6); }
      .fbs-cd b { font-size: .95rem; color: #fff; font-variant-numeric: tabular-nums; text-transform: none; letter-spacing: .02em; }
      .fbs-cta { background: #c8102e; text-align: center; padding: 9px 12px; font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: #fff; }
      .fbs-close { position: absolute; top: 4px; right: 4px; width: 26px; height: 26px; background: rgba(0,0,0,.15); border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #111; font-size: 12px; line-height: 1; padding: 0; }
      @media (max-width: 480px) {
        .fb-sticker { left: 10px; width: 150px; }
        .fbs-desc, .fbs-label { display: none; }
        .fbs-big { font-size: 1.3rem; }
      }
    </style>
    <script is:inline>
      (function () {
        var el = document.getElementById('fb-sticker');
        if (!el) return;
        var p = location.pathname;
        var pagina = /^\/(ingrijire-ten|ingrijire-corp|ingrijire-par|machiaj)\//.test(p) || /\/brand\/(farmec|gerovital|aslavital)/.test(p);
        if (!pagina || p.indexOf('/farmec-black-friday/') === 0) return;
        // ?fbtest=2026-11-10 — previzualizare pentru o anumită zi (doar pentru verificare)
        var t = (location.search.match(/fbtest=([\d-]+)/) || [])[1];
        var offset = t ? new Date(t + 'T12:00:00+02:00') - new Date() : 0;
        var acum = function () { return new Date(Date.now() + offset); };
        var DE_LA = new Date('2026-10-30T00:00:00+02:00'), START = new Date('2026-11-05T00:00:00+02:00'), FINAL = new Date('2026-11-23T23:59:59+02:00');
        var n = acum();
        if (n < DE_LA || n > FINAL) return;
        var pre = n < START, end = pre ? START : FINAL;
        if (!pre) {
          document.getElementById('fbs-big').textContent = 'BF';
          document.getElementById('fbs-label').innerHTML = 'Black Friday<br>Beauty Kingdom';
          document.getElementById('fbs-desc').textContent = 'Gerovital și seturi cadou, pe farmec.ro';
          document.getElementById('fbs-cdt').textContent = 'Se termină în';
          document.getElementById('fbs-cta').textContent = 'Vezi ofertele →';
        }
        var cd = document.getElementById('fbs-cd');
        var d2 = function (x) { return (x < 10 ? '0' : '') + x; };
        var tick = function () {
          var r = Math.max(0, Math.floor((end - acum()) / 1000));
          if (!r) { location.reload(); return; }
          var z = Math.floor(r / 86400);
          cd.textContent = (z ? z + (z === 1 ? ' zi ' : ' zile ') : '') + d2(Math.floor(r % 86400 / 3600)) + ':' + d2(Math.floor(r % 3600 / 60)) + ':' + d2(r % 60);
        };
        tick(); setInterval(tick, 1000);

        // alternare cu stickerul „Farmec 15 ani” (același loc, stânga jos)
        var tb = document.getElementById('tombola-sticker');
        var tbVizibil = tb && getComputedStyle(tb).display !== 'none';
        var inchis = { fb: false, tb: false };
        el.style.display = 'block';
        var timer = null;
        if (tbVizibil) {
          var arata = function (care) {
            var a = care === 'fb' ? el : tb, b = care === 'fb' ? tb : el;
            b.style.opacity = '0'; b.style.pointerEvents = 'none';
            setTimeout(function () { b.style.display = 'none'; a.style.display = 'block'; a.style.opacity = '0'; a.style.pointerEvents = '';
              requestAnimationFrame(function () { a.style.opacity = '1'; }); }, 450);
          };
          tb.style.transition = 'opacity .45s, transform .2s';
          tb.style.display = 'none';
          var curent = 'fb';
          timer = setInterval(function () {
            if (inchis.fb || inchis.tb) return;
            curent = curent === 'fb' ? 'tb' : 'fb'; arata(curent);
          }, 6000);
          var tbx = document.getElementById('ts-close');
          if (tbx) tbx.addEventListener('click', function () { inchis.tb = true; clearInterval(timer); if (!inchis.fb) setTimeout(function () { el.style.display = 'block'; el.style.opacity = '1'; el.style.pointerEvents = ''; }, 340); });
        }
        document.getElementById('fbs-close').addEventListener('click', function (e) {
          e.preventDefault(); e.stopPropagation(); inchis.fb = true; if (timer) clearInterval(timer);
          el.style.opacity = '0'; setTimeout(function () { el.style.display = 'none';
            if (tbVizibil && !inchis.tb) { tb.style.display = 'block'; tb.style.opacity = '1'; tb.style.pointerEvents = ''; } }, 320);
        });
      })();
    </script>
    <!-- ── END FARMEC BLACK FRIDAY STICKER ── -->

    <!-- ── GEROVITAL STICKER: Anniversary Shopping Event — 20 oct 12:00 – 21 oct 23:59, 2026 ── -->
    <!-- Cat timp e activ, inlocuieste sticker-ul Farmec 30% din dreapta; dupa final dispare singur si revine cel Farmec. -->
    <a class="gv-sticker" id="gv-sticker" href="/gerovital-aniversar/" style="display:none">
      <div class="gvs-top">
        <span class="gvs-pct">-40%</span>
        <span class="gvs-label">Până la<br>Gerovital</span>
      </div>
      <div class="gvs-mid">
        <div class="gvs-brand">Doar 36 de ore</div>
        <div class="gvs-desc">Anniversary Shopping Event pe farmec.ro</div>
      </div>
      <div class="gvs-timer">
        <div class="gvs-block"><span class="gvs-num" id="gvs-h">--</span><span class="gvs-lbl">Ore</span></div>
        <span class="gvs-sep">:</span>
        <div class="gvs-block"><span class="gvs-num" id="gvs-m">--</span><span class="gvs-lbl">Min</span></div>
        <span class="gvs-sep">:</span>
        <div class="gvs-block"><span class="gvs-num" id="gvs-s">--</span><span class="gvs-lbl">Sec</span></div>
      </div>
      <div class="gvs-cta">
        Vezi gamele
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
      <button class="gvs-close" id="gvs-close" title="Închide" aria-label="Închide">✕</button>
    </a>
    <style is:global>
      .gv-sticker {
        position: fixed; bottom: 24px; right: 24px; z-index: 9999;
        width: 178px; background: #2a0f2e; color: #fff;
        border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,.28), 0 2px 8px rgba(214,168,74,.3);
        overflow: hidden; text-decoration: none;
        transition: transform .2s, box-shadow .2s;
        font-family: 'Segoe UI', system-ui, sans-serif;
      }
      .gv-sticker:hover { transform: translateY(-3px); box-shadow: 0 12px 40px rgba(0,0,0,.32), 0 4px 16px rgba(214,168,74,.4); }
