    <script is:inline>
      (function () {
        // Ascunde automat după finalul ofertei (1 noiembrie 2026)
        if (new Date() > new Date('2026-11-01T23:59:59+02:00')) { var psEl = document.getElementById('promo-sticker'); if (psEl) psEl.style.display = 'none'; }

        // Countdown
        var end = new Date('2026-11-01T23:59:59');
        function updateTimer() {
          var diff = Math.max(0, end - new Date());
          var d = Math.floor(diff / 86400000); diff %= 86400000;
          var h = Math.floor(diff / 3600000);  diff %= 3600000;
          var m = Math.floor(diff / 60000);    diff %= 60000;
          var s = Math.floor(diff / 1000);
          function pad(n) { return String(n).padStart(2, '0'); }
          var ed = document.getElementById('ps-d');
          var eh = document.getElementById('ps-h');
          var em = document.getElementById('ps-m');
          var es = document.getElementById('ps-s');
          if (ed) ed.textContent = pad(d);
          if (eh) eh.textContent = pad(h);
          if (em) em.textContent = pad(m);
          if (es) es.textContent = pad(s);
        }
        updateTimer();
        setInterval(updateTimer, 1000);

        // Buton închidere
        var btn = document.getElementById('ps-close');
        if (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault(); e.stopPropagation();
            var el = document.getElementById('promo-sticker');
            if (el) { el.style.transition = 'opacity .3s, transform .3s'; el.style.opacity = '0'; el.style.transform = 'translateY(20px)'; setTimeout(function(){ el.style.display = 'none'; }, 320); }
          });
        }
      })();
    </script>
