      .gvs-label { font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .09em; text-align: right; line-height: 1.35; color: #2a0f2e; }
      .gvs-mid { padding: 10px 14px 6px; border-bottom: 1px solid rgba(255,255,255,.1); }
      .gvs-brand { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #d6a84a; margin-bottom: 3px; }
      .gvs-desc { font-size: .78rem; color: rgba(255,255,255,.8); line-height: 1.4; }
      .gvs-timer { padding: 8px 14px; display: flex; gap: 6px; justify-content: center; align-items: center; }
      .gvs-block { display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,.08); border-radius: 5px; padding: 4px 6px; min-width: 34px; }
      .gvs-num { font-size: .9rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1; color: #fff; }
      .gvs-lbl { font-size: .48rem; text-transform: uppercase; letter-spacing: .06em; color: rgba(255,255,255,.5); margin-top: 2px; }
      .gvs-sep { font-size: .75rem; color: rgba(255,255,255,.3); margin-top: -4px; }
