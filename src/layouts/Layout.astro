      }
    </style>
    <script is:inline>
      (function () {
        var el = document.getElementById('dx-sticker');
        if (!el) return;
        var p = location.pathname;
        // Paginile "de detox": categoria Wellness si tipul Slabire & Detox de la Vitamine
        var eDetox = p.indexOf('/wellness/') === 0 || p.indexOf('/vitamine-suplimente/tip/slabire-detox/') === 0;
        var paginaDetox = p.indexOf('/detox/') === 0;
        if (!eDetox && !paginaDetox) return;
        ['promo-sticker', 'gv-sticker'].forEach(function (id) { var x = document.getElementById(id); if (x) x.style.setProperty('display', 'none', 'important'); });
        if (paginaDetox) { var t = document.getElementById('tombola-sticker'); if (t) t.style.display = 'none'; return; } // pe landing page nu punem stickere peste butoane
        el.style.display = 'block';
        var btn = document.getElementById('dxs-close');
        if (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault(); e.stopPropagation();
            el.style.transition = 'opacity .3s, transform .3s'; el.style.opacity = '0'; el.style.transform = 'translateY(20px)';
            setTimeout(function(){ el.style.display = 'none'; }, 320);
          });
        }
      })();
