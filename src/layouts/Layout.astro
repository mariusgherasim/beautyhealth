---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = "/og-default.jpg",
} = Astro.props;

const siteName = "BeautyHealth";
const absoluteOgImage = new URL(ogImage, "https://beauty-healths.com").href;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HS59YL4Y3D"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-HS59YL4Y3D');
    </script>

    <!-- TrustBox script -->
    <script is:inline type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
    <!-- End TrustBox script -->

    <slot name="head" />
  </head>
  <body>
    <slot />

    <script is:inline>
      // bh_affiliate_click - delegare globala, functioneaza atat pentru cardurile
      // randate de Astro (paginare normala) cat si pentru cele injectate de JS
      // (rezultate cautare), pentru ca ambele au aceleasi data-attributes.
      document.addEventListener('click', function (e) {
        var card = e.target.closest('.product-card');
        if (!card) return;
        if (typeof gtag !== 'function') return;
        gtag('event', 'bh_affiliate_click', {
          product_id: card.dataset.productId || '',
          product_title: card.dataset.productTitle || '',
          product_price: card.dataset.productPrice || '',
          page_location: window.location.href,
        });
      });
    </script>

    <!-- ── PROMO STICKER: Farmec 30% — 14 Oct–1 Nov 2026 ── -->
    <a class="promo-sticker" id="promo-sticker"
       href="https://event.2performant.com/events/click?ad_type=quicklink&aff_code=676a7e7d9&unique=1dfbc028f&redirect_to=https%253A//www.farmec.ro/promo/complete-care"
       target="_blank" rel="noopener sponsored">
      <div class="ps-top">
        <span class="ps-pct">30%</span>
        <span class="ps-label">Reducere<br>îngrijire ten</span>
      </div>
      <div class="ps-mid">
        <div class="ps-brand">Farmec</div>
        <div class="ps-desc">Complete Care — reducere directă în preț</div>
      </div>
      <div class="ps-timer">
        <div class="ps-block"><span class="ps-num" id="ps-d">17</span><span class="ps-lbl">Zile</span></div>
        <span class="ps-sep">:</span>
        <div class="ps-block"><span class="ps-num" id="ps-h">00</span><span class="ps-lbl">Ore</span></div>
        <span class="ps-sep">:</span>
        <div class="ps-block"><span class="ps-num" id="ps-m">00</span><span class="ps-lbl">Min</span></div>
        <span class="ps-sep">:</span>
        <div class="ps-block"><span class="ps-num" id="ps-s">00</span><span class="ps-lbl">Sec</span></div>
      </div>
      <div class="ps-cta">
        Vezi oferta
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
      <button class="ps-close" id="ps-close" title="Închide" aria-label="Închide">✕</button>
    </a>

    <!-- ── TOMBOLA STICKER: Farmec 15 ani — 5 Oct–18 Nov 2026 ── -->
    <a class="tombola-sticker" id="tombola-sticker" href="/farmec-15-ani.html">
      <div class="ts-top">
        <span class="ts-big">15</span>
        <span class="ts-label">Ani<br>aniversare</span>
      </div>
      <div class="ts-mid">
        <div class="ts-brand">Farmec · Tombola</div>
        <div class="ts-desc">Premii aniversare pe farmec.ro și în magazinele Gerovital</div>
      </div>
      <div class="ts-timer">
        <div class="ts-block"><span class="ts-num" id="ts-d">--</span><span class="ts-lbl">Zile</span></div>
        <span class="ts-sep">:</span>
        <div class="ts-block"><span class="ts-num" id="ts-h">--</span><span class="ts-lbl">Ore</span></div>
        <span class="ts-sep">:</span>
        <div class="ts-block"><span class="ts-num" id="ts-m">--</span><span class="ts-lbl">Min</span></div>
      </div>
      <div class="ts-cta">
        Vezi cum participi
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
      <button class="ts-close" id="ts-close" title="Închide" aria-label="Închide">✕</button>
    </a>
    <style is:global>
      .tombola-sticker {
        position: fixed; bottom: 24px; left: 24px; z-index: 9999;
        width: 178px; background: #0B1F4A; color: #fff;
        border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,.28), 0 2px 8px rgba(200,155,60,.25);
        overflow: hidden; text-decoration: none; display: block;
        transition: transform .2s, box-shadow .2s;
        font-family: 'Segoe UI', system-ui, sans-serif;
      }
      .tombola-sticker:hover { transform: translateY(-3px); box-shadow: 0 12px 40px rgba(0,0,0,.32), 0 4px 16px rgba(200,155,60,.35); }
      .ts-top { background: #C89B3C; padding: 10px 14px 8px; display: flex; align-items: center; justify-content: space-between; }
      .ts-big { font-size: 1.9rem; font-weight: 900; line-height: 1; font-family: Georgia, serif; color: #1a1713; }
      .ts-label { font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .09em; text-align: right; line-height: 1.35; color: #1a1713; }
      .ts-mid { padding: 10px 14px 6px; border-bottom: 1px solid rgba(255,255,255,.1); }
      .ts-brand { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #C89B3C; margin-bottom: 3px; }
      .ts-desc { font-size: .78rem; color: rgba(255,255,255,.8); line-height: 1.4; }
      .ts-timer { padding: 8px 14px; display: flex; gap: 6px; justify-content: center; align-items: center; }
      .ts-block { display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,.08); border-radius: 5px; padding: 4px 6px; min-width: 38px; }
      .ts-num { font-size: .9rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1; color: #fff; }
      .ts-lbl { font-size: .48rem; text-transform: uppercase; letter-spacing: .06em; color: rgba(255,255,255,.5); margin-top: 2px; }
      .ts-sep { font-size: .75rem; color: rgba(255,255,255,.3); margin-top: -4px; }
      .ts-cta { background: #c8102e; text-align: center; padding: 9px 14px; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; display: flex; align-items: center; justify-content: center; gap: 5px; color: #fff; }
      .ts-close { position: absolute; top: 7px; right: 7px; width: 18px; height: 18px; background: rgba(0,0,0,.18); border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #1a1713; font-size: 10px; line-height: 1; padding: 0; }
      .ts-close:hover { background: rgba(0,0,0,.3); }
      @media (max-width: 480px) {
        .tombola-sticker { bottom: 16px; left: 16px; width: 160px; }
      }
    </style>
    <script is:inline>
      (function () {
        var el = document.getElementById('tombola-sticker');
        if (!el) return;
        var end = new Date('2026-11-18T23:59:59+02:00');
        // Ascunde după final sau dacă a fost închis
        if (new Date() > end) { el.style.display = 'none'; return; }
        try { if (localStorage.getItem('ts-farmec15-closed') === '1') { el.style.display = 'none'; return; } } catch(e) {}
        // Nu afișa sticker-ul chiar pe pagina campaniei
        if (location.pathname.indexOf('farmec-15-ani') !== -1) { el.style.display = 'none'; return; }

        function pad(n) { return String(n).padStart(2, '0'); }
        function tick() {
          var diff = Math.max(0, end - new Date());
          var d = Math.floor(diff / 86400000); diff %= 86400000;
          var h = Math.floor(diff / 3600000);  diff %= 3600000;
          var m = Math.floor(diff / 60000);
          document.getElementById('ts-d').textContent = pad(d);
          document.getElementById('ts-h').textContent = pad(h);
          document.getElementById('ts-m').textContent = pad(m);
        }
        tick(); setInterval(tick, 30000);

        var btn = document.getElementById('ts-close');
        if (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault(); e.stopPropagation();
            el.style.transition = 'opacity .3s, transform .3s'; el.style.opacity = '0'; el.style.transform = 'translateY(20px)';
            setTimeout(function(){ el.style.display = 'none'; }, 320);
            try { localStorage.setItem('ts-farmec15-closed', '1'); } catch(e) {}
          });
        }
      })();
    </script>
    <!-- ── END TOMBOLA STICKER ── -->

    <!-- ── TRUSTPILOT Floating Sticker ── -->
    <div id="tp-sticker">
      <div class="tp-sticker-label">Recenzii clienți</div>
      <!-- TrustBox widget - Review Collector -->
      <div class="trustpilot-widget"
           data-locale="ro-RO"
           data-template-id="56278e9abfbbba0bdcd568bc"
           data-businessunit-id="6ad21e64dea7b17b7f0585d7"
           data-style-height="52px"
           data-style-width="220px"
           data-token="5d8638c8-df43-434b-b812-50901f6b578f">
        <a href="https://www.trustpilot.com/review/beauty-healths.com"
           target="_blank" rel="noopener">Trustpilot</a>
      </div>
      <!-- End TrustBox widget -->
    </div>
    <style is:global>
      #tp-sticker {
        position: fixed;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 9998;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 20px rgba(0,0,0,.15);
        padding: 8px 12px 6px;
        min-width: 220px;
      }
      .tp-sticker-label {
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #555;
        margin-bottom: 4px;
        font-family: 'Segoe UI', system-ui, sans-serif;
      }
      @media (max-width: 640px) {
        #tp-sticker { display: none; }
      }
    </style>
    <!-- ── END TRUSTPILOT ── -->

    <style is:global>
      .promo-sticker {
        position: fixed; bottom: 24px; right: 24px; z-index: 9999;
        width: 178px; background: #1a1713; color: #fff;
        border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,.28), 0 2px 8px rgba(200,16,46,.25);
        overflow: hidden; text-decoration: none; display: block;
        transition: transform .2s, box-shadow .2s;
        font-family: 'Segoe UI', system-ui, sans-serif;
      }
      .promo-sticker:hover { transform: translateY(-3px); box-shadow: 0 12px 40px rgba(0,0,0,.32), 0 4px 16px rgba(200,16,46,.30); }
      .ps-top { background: #c8102e; padding: 10px 14px 8px; display: flex; align-items: center; justify-content: space-between; }
      .ps-pct { font-size: 1.9rem; font-weight: 900; line-height: 1; letter-spacing: -.02em; font-family: Georgia, serif; color: #fff; }
      .ps-label { font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .09em; opacity: .9; text-align: right; line-height: 1.35; color: #fff; }
      .ps-mid { padding: 10px 14px 6px; border-bottom: 1px solid rgba(255,255,255,.08); }
      .ps-brand { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #c8a96e; margin-bottom: 3px; }
      .ps-desc { font-size: .78rem; color: rgba(255,255,255,.75); line-height: 1.4; }
      .ps-timer { padding: 8px 14px; display: flex; gap: 6px; justify-content: center; align-items: center; }
      .ps-block { display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,.07); border-radius: 5px; padding: 4px 6px; min-width: 34px; }
      .ps-num { font-size: .9rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1; color: #fff; }
      .ps-lbl { font-size: .48rem; text-transform: uppercase; letter-spacing: .06em; color: rgba(255,255,255,.45); margin-top: 2px; }
      .ps-sep { font-size: .75rem; color: rgba(255,255,255,.3); margin-top: -4px; }
      .ps-cta { background: #c8102e; text-align: center; padding: 9px 14px; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; display: flex; align-items: center; justify-content: center; gap: 5px; color: #fff; }
      .ps-close { position: absolute; top: 7px; right: 7px; width: 18px; height: 18px; background: rgba(255,255,255,.18); border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 10px; line-height: 1; padding: 0; transition: background .15s; }
      .ps-close:hover { background: rgba(255,255,255,.32); }
      @media (max-width: 480px) {
        .promo-sticker { bottom: 16px; right: 16px; width: 160px; }
      }
    </style>

    <script is:inline>
      (function () {
        // Ascunde dacă a fost deja închis
        try { if (localStorage.getItem('ps-farmec-closed') === '1') { document.getElementById('promo-sticker').style.display = 'none'; } } catch(e) {}
        // Ascunde automat după finalul ofertei (1 noiembrie 2026)
        if (new Date() > new Date('2026-11-01T23:59:59+02:00')) { var psEl = document.getElementById('promo-sticker'); if (psEl) psEl.style.display = 'none'; }

        // Countdown
        var end = new Date('2026-11-01T23:59:59');
        function updateTimer() {
          var diff = Math.max(0, end - new Date());
          var d = Math.floor(diff / 86400000); diff %= 86400000;
          var h = Math.floor(diff / 3600000);  diff %= 3600000;
          var m = Math.floor(diff / 60000);    diff %= 60000;
          var s = Math.floor(diff / 1000);
          function pad(n) { return String(n).padStart(2, '0'); }
          var ed = document.getElementById('ps-d');
          var eh = document.getElementById('ps-h');
          var em = document.getElementById('ps-m');
          var es = document.getElementById('ps-s');
          if (ed) ed.textContent = pad(d);
          if (eh) eh.textContent = pad(h);
          if (em) em.textContent = pad(m);
          if (es) es.textContent = pad(s);
        }
        updateTimer();
        setInterval(updateTimer, 1000);

        // Buton închidere
        var btn = document.getElementById('ps-close');
        if (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault(); e.stopPropagation();
            var el = document.getElementById('promo-sticker');
            if (el) { el.style.transition = 'opacity .3s, transform .3s'; el.style.opacity = '0'; el.style.transform = 'translateY(20px)'; setTimeout(function(){ el.style.display = 'none'; }, 320); }
            try { localStorage.setItem('ps-farmec-closed', '1'); } catch(e) {}
          });
        }
      })();
    </script>
    <!-- ── END PROMO STICKER ── -->
  </body>
</html>

<style is:global>
  :root {
    --navy: #0B1F4A;
    --gold: #C89B3C;
    --bg: #FAF8F5;
    --text: #1A1A1A;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: 'Segoe UI', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
  }
  a { color: var(--navy); }
  img { max-width: 100%; display: block; }
</style>
