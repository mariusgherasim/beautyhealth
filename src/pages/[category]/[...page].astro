---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import CategorySearch from '../../components/CategorySearch.astro';
import BannerSlot from '../../components/BannerSlot.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Newsletter from '../../components/Newsletter.astro';
import GhiduriUtile from '../../components/GhiduriUtile.astro';
import { categories, getCategoryBySlug } from '../../data/categories.js';
import { produseCategorie, tipuriCategorie, brandsCategorie, cuNumar } from '../../data/catalog.mjs';

export function getStaticPaths({ paginate }) {
  const PAGE_SIZE = 24;
  return categories.flatMap((cat) =>
    paginate(produseCategorie(cat.slug), {
      params: { category: cat.slug },
      pageSize: PAGE_SIZE,
    })
  );
}

const { page } = Astro.props;
const { category: categorySlug } = Astro.params;
const cat = getCategoryBySlug(categorySlug);
const catBrands = brandsCategorie(categorySlug);
const catTipuri = tipuriCategorie(categorySlug);
const intro = cuNumar(cat.intro, page.total);
const metaDescription = cuNumar(cat.metaDescription, page.total);

const canonicalBase = `https://beauty-healths.com/${categorySlug}/`;
const canonical = page.currentPage === 1 ? canonicalBase : `${canonicalBase}${page.currentPage}/`;

const title = page.currentPage === 1
  ? `${cat.seoTitle} | BeautyHealth`
  : `${cat.seoTitle} — Pagina ${page.currentPage} | BeautyHealth`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": cat.name,
  "url": canonical,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Acasă", "item": "https://beauty-healths.com/" },
      { "@type": "ListItem", "position": 2, "name": cat.name, "item": canonicalBase }
    ]
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": page.data.map((p, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": p.official_url
    }))
  }
};
---
<Layout title={title} description={metaDescription} canonical={canonical}>
  <Fragment slot="head">
    {page.currentPage > 1 && <link rel="prev" href={page.currentPage === 2 ? canonicalBase : `${canonicalBase}${page.currentPage - 1}/`} />}
    {page.url.next && <link rel="next" href={`https://beauty-healths.com${page.url.next}`} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Header />

  <main class="wrap">
    <nav class="breadcrumbs" aria-label="breadcrumb">
      <a href="/">Acasă</a> <span>/</span> <span>{cat.name}</span>
    </nav>

    <BannerSlot category={categorySlug} size="728x90" />

    <h1>{cat.name}</h1>

    {page.currentPage === 1 && (
      <p class="intro">{intro}</p>
    )}

    <!-- Linia 1: navigare categorii principale -->
    <div class="nav-row">
      <span class="nav-label">Categorii</span>
      <div class="category-pills">
        {categories.map((c) => (
          <a href={`/${c.slug}/`} class={c.slug === categorySlug ? 'cat-pill active' : 'cat-pill'}>{c.name}</a>
        ))}
      </div>
    </div>

    <!-- Linia 2: tipuri de produs -->
    {catTipuri.length > 0 && (
      <div class="nav-row">
        <span class="nav-label">Tipuri</span>
        <div class="sub-pills">
          {catTipuri.map((t) => (
            <a href={`/${categorySlug}/tip/${t.slug}/`} class="sub-pill">
              {t.name}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Linia 3: branduri (dacă există) -->
    {catBrands.length > 0 && (
      <div class="nav-row">
        <span class="nav-label">Branduri</span>
        <div class="brand-pills">
          {catBrands.map((brand) => (
            <a href={`/${categorySlug}/brand/${brand.slug}/`} class="brand-pill">
              {brand.name}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Căutare -->
    <CategorySearch categorySlug={categorySlug} categoryName={cat.name} />

    <p class="results-count">{page.total} produse găsite — pagina {page.currentPage} din {page.lastPage}</p>

    <h2 class="sr-only">Produse</h2>

    <div class="grid paginated">
      {page.data.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

    <nav class="pagination" aria-label="paginare">
      {page.url.prev && <a href={page.url.prev}>← Pagina anterioară</a>}
      <span>Pagina {page.currentPage} / {page.lastPage}</span>
      {page.url.next && <a href={page.url.next}>Pagina următoare →</a>}
    </nav>

    <BannerSlot category={categorySlug} />
    <GhiduriUtile categorie={categorySlug} />
    <Newsletter />
  </main>

  <Footer />

  <script is:inline define:vars={{ categorySlug, currentPage: page.currentPage }}>
    if (typeof gtag === 'function') {
      gtag('event', 'bh_category_page_view', {
        category: categorySlug,
        page_number: currentPage,
      });
    }
  </script>
</Layout>

<style>
  .wrap { max-width: 1200px; margin: 0 auto; padding: 20px 16px 60px; }
  .breadcrumbs { font-size: 0.85rem; color: #6b6b6b; margin-bottom: 12px; }
  .breadcrumbs a { color: #6b6b6b; text-decoration: none; }
  h1 { color: var(--navy); margin-bottom: 8px; }
  .intro { max-width: 780px; color: #444; margin-bottom: 16px; }

  /* Rânduri de navigare: label + pills */
  .nav-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .nav-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6b6b6b;
    font-weight: 700;
    padding-top: 7px;
    white-space: nowrap;
    min-width: 52px;
  }

  /* Pills categorii principale — dimensiune standard */
  .category-pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .cat-pill {
    padding: 6px 13px;
    border-radius: 20px;
    background: #fff;
    border: 1px solid #ddd;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--navy);
    transition: background 0.15s, border-color 0.15s;
  }
  .cat-pill:hover { border-color: var(--navy); }
  .cat-pill.active { background: var(--navy); color: #fff; border-color: var(--navy); }

  /* Pills subcategorii — mai mici, accent cald */
  .sub-pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .sub-pill {
    padding: 4px 11px;
    border-radius: 20px;
    background: #fff8ee;
    border: 1px solid #e8c97a;
    font-size: 0.78rem;
    text-decoration: none;
    color: #7a5c00;
    font-weight: 500;
    transition: background 0.15s;
  }
  .sub-pill:hover { background: var(--gold); color: var(--navy); border-color: var(--gold); }

  /* Pills branduri — mai mici, fond neutru, text bold */
  .brand-pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .brand-pill {
    padding: 3px 10px;
    border-radius: 5px;
    background: #f0f0f0;
    border: 1px solid #d8d8d8;
    font-size: 0.73rem;
    text-decoration: none;
    color: var(--navy);
    font-weight: 700;
    letter-spacing: 0.03em;
    transition: background 0.15s;
  }
  .brand-pill:hover { background: var(--navy); color: #fff; border-color: var(--navy); }

  .results-count { color: #6b6b6b; font-size: 0.85rem; margin: 12px 0; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }
  .pagination {
    display: flex; justify-content: center; align-items: center; gap: 20px;
    margin-top: 36px; font-size: 0.9rem;
  }
  .pagination a { color: var(--gold-text, #8a6a1f); font-weight: 600; text-decoration: none; }

  @media (max-width: 600px) {
    .nav-label { min-width: 44px; font-size: 0.68rem; }
    .cat-pill { font-size: 0.78rem; padding: 5px 10px; }
    .sub-pill { font-size: 0.72rem; padding: 4px 9px; }
    .brand-pill { font-size: 0.68rem; padding: 3px 8px; }
    .grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
    .pagination { flex-direction: column; gap: 10px; }
  }
</style>
