---
import Layout from '../../../../layouts/Layout.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Newsletter from '../../../../components/Newsletter.astro';
import BannerSlot from '../../../../components/BannerSlot.astro';
import { categories, getCategoryBySlug } from '../../../../data/categories.js';
import { produseBrand, brandsCategorie } from '../../../../data/catalog.mjs';

// Pagini de BRAND: /{categorie}/brand/{brand}/ — brandurile de pe randul categoriei (vezi brands.js)
export function getStaticPaths({ paginate }) {
  const PAGE_SIZE = 24;
  return categories.flatMap((cat) =>
    brandsCategorie(cat.slug).flatMap((b) =>
      paginate(produseBrand(cat.slug, b.slug), {
        params: { category: cat.slug, brand: b.slug },
        props: { brand: b },
        pageSize: PAGE_SIZE,
      })
    )
  );
}

const { page, brand } = Astro.props;
const { category: categorySlug, brand: brandSlug } = Astro.params;

const cat = getCategoryBySlug(categorySlug);

const canonicalBase = `https://beauty-healths.com/${categorySlug}/brand/${brandSlug}/`;
const canonical = page.currentPage === 1
  ? canonicalBase
  : `${canonicalBase}${page.currentPage}/`;

const title = page.currentPage === 1
  ? `${brand.name} — ${cat.name} | BeautyHealth`
  : `${brand.name} — ${cat.name}, Pagina ${page.currentPage} | BeautyHealth`;

const description = `${page.total} produse ${brand.name} din categoria ${cat.name}, prețuri comparate zilnic.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${brand.name} — ${cat.name}`,
  "url": canonical,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Acasă", "item": "https://beauty-healths.com/" },
      { "@type": "ListItem", "position": 2, "name": cat.name, "item": `https://beauty-healths.com/${categorySlug}/` },
      { "@type": "ListItem", "position": 3, "name": brand.name, "item": canonicalBase }
    ]
  }
};
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    {page.currentPage > 1 && (
      <link rel="prev" href={page.currentPage === 2 ? canonicalBase : `${canonicalBase}${page.currentPage - 1}/`} />
    )}
    {page.url.next && (
      <link rel="next" href={`https://beauty-healths.com${page.url.next}`} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Header />

  <main class="wrap">
    <nav class="breadcrumbs" aria-label="breadcrumb">
      <a href="/">Acasă</a>
      <span>/</span>
      <a href={`/${categorySlug}/`}>{cat.name}</a>
      <span>/</span>
      <span>{brand.name}</span>
    </nav>

    <BannerSlot category={categorySlug} size="728x90" />

    <h1>{brand.name} <span class="cat-label">— {cat.name}</span></h1>

    {page.currentPage === 1 && (
      <p class="intro">
        {page.total} produse {brand.name} din categoria {cat.name}, prețuri comparate zilnic.
      </p>
    )}

    <p class="results-count">
      {page.total} produse — pagina {page.currentPage} din {page.lastPage}
    </p>

    <h2 class="sr-only">Produse</h2>

    <div class="grid">
      {page.data.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

    <nav class="pagination" aria-label="paginare">
      {page.url.prev && <a href={page.url.prev}>← Pagina anterioară</a>}
      <span>Pagina {page.currentPage} / {page.lastPage}</span>
      {page.url.next && <a href={page.url.next}>Pagina următoare →</a>}
    </nav>

    <BannerSlot category={categorySlug} />
    <Newsletter />
  </main>

  <Footer />
</Layout>

<style>
  .wrap { max-width: 1200px; margin: 0 auto; padding: 20px 16px 60px; }
  .breadcrumbs { font-size: 0.85rem; color: #6b6b6b; margin-bottom: 12px; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  .breadcrumbs a { color: #6b6b6b; text-decoration: none; }
  .breadcrumbs a:hover { color: var(--gold); }
  h1 { color: var(--navy); margin-bottom: 8px; font-size: 1.8rem; }
  .cat-label { font-weight: 400; font-size: 1.1rem; color: #666; }
  .intro { max-width: 780px; color: #444; margin-bottom: 16px; }
  .results-count { color: #6b6b6b; font-size: 0.85rem; margin-bottom: 16px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }
  .pagination {
    display: flex; justify-content: center; align-items: center; gap: 20px;
    margin-top: 36px; font-size: 0.9rem;
  }
  .pagination a { color: var(--gold-text, #8a6a1f); font-weight: 600; text-decoration: none; }
  @media (max-width: 480px) {
    .grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
    .pagination { flex-direction: column; gap: 10px; }
    h1 { font-size: 1.4rem; }
  }
</style>
