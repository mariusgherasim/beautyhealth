---
import Layout from '../../../../layouts/Layout.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Newsletter from '../../../../components/Newsletter.astro';
import GhiduriUtile from '../../../../components/GhiduriUtile.astro';
import BannerSlot from '../../../../components/BannerSlot.astro';
import { categories, getCategoryBySlug } from '../../../../data/categories.js';
import { produseTip, tipuriCategorie, cuNumar } from '../../../../data/catalog.mjs';

// Pagini de TIP: /{categorie}/tip/{tip}/  (doar tipurile cu minim 5 produse)
export function getStaticPaths({ paginate }) {
  const PAGE_SIZE = 24;
  return categories.flatMap((cat) =>
    tipuriCategorie(cat.slug).flatMap((t) =>
      paginate(produseTip(cat.slug, t.slug), {
        params: { category: cat.slug, tip: t.slug },
        props: { tip: t },
        pageSize: PAGE_SIZE,
      })
    )
  );
}

const { page, tip } = Astro.props;
const { category: categorySlug } = Astro.params;
const cat = getCategoryBySlug(categorySlug);
const siblings = tipuriCategorie(categorySlug);

const intro = tip.intro ||
  cuNumar(`Câte oferte ai verificat ultima dată înainte să cumperi? Aici găsești {N} de produse din „${tip.name}” (${cat.name}), de la mai multe magazine online, ca să compari prețul înainte să comanzi.`, page.total);
const metaDescription = `${tip.name} — ${page.total} produse din ${cat.name}, prețuri comparate de la mai multe magazine online.`;

const canonicalBase = `https://beauty-healths.com/${categorySlug}/tip/${tip.slug}/`;
const canonical = page.currentPage === 1 ? canonicalBase : `${canonicalBase}${page.currentPage}/`;

const title = page.currentPage === 1
  ? `${tip.name} — ${cat.name} | BeautyHealth`
  : `${tip.name} — ${cat.name}, Pagina ${page.currentPage} | BeautyHealth`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${tip.name} — ${cat.name}`,
  "url": canonical,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Acasă", "item": "https://beauty-healths.com/" },
      { "@type": "ListItem", "position": 2, "name": cat.name, "item": `https://beauty-healths.com/${categorySlug}/` },
      { "@type": "ListItem", "position": 3, "name": tip.name, "item": canonicalBase }
    ]
  }
};
---

<Layout title={title} description={metaDescription} canonical={canonical}>
  <Fragment slot="head">
    {page.currentPage > 1 && (
      <link rel="prev" href={page.currentPage === 2 ? canonicalBase : `${canonicalBase}${page.currentPage - 1}/`} />
    )}
    {page.url.next && (
      <link rel="next" href={`https://beauty-healths.com${page.url.next}`} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Header />

  <main class="wrap">
    <nav class="breadcrumbs" aria-label="breadcrumb">
      <a href="/">Acasă</a>
      <span>/</span>
      <a href={`/${categorySlug}/`}>{cat.name}</a>
      <span>/</span>
      <span>{tip.name}</span>
    </nav>

    <BannerSlot category={categorySlug} size="728x90" />

    <h1>{tip.name} <span class="cat-label">— {cat.name}</span></h1>

    {page.currentPage === 1 && (
      <p class="intro">{intro}</p>
    )}

    <div class="sub-pills">
      {siblings.map((t) => (
        <a href={`/${categorySlug}/tip/${t.slug}/`} class={t.slug === tip.slug ? 'sub-pill active' : 'sub-pill'}>{t.name}</a>
      ))}
    </div>

    <p class="results-count">
      {page.total} produse — pagina {page.currentPage} din {page.lastPage}
    </p>

    <div class="grid">
      {page.data.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

    <nav class="pagination" aria-label="paginare">
      {page.url.prev && <a href={page.url.prev}>← Pagina anterioară</a>}
      <span>Pagina {page.currentPage} / {page.lastPage}</span>
      {page.url.next && <a href={page.url.next}>Pagina următoare →</a>}
    </nav>

    <BannerSlot category={categorySlug} />
    <GhiduriUtile categorie={categorySlug} />
    <Newsletter />
  </main>

  <Footer />
</Layout>

<style>
  .wrap { max-width: 1200px; margin: 0 auto; padding: 20px 16px 60px; }
  .breadcrumbs { font-size: 0.85rem; color: #888; margin-bottom: 12px; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  .breadcrumbs a { color: #888; text-decoration: none; }
  .breadcrumbs a:hover { color: var(--gold); }
  h1 { color: var(--navy); margin-bottom: 8px; font-size: 1.8rem; }
  .cat-label { font-weight: 400; font-size: 1.1rem; color: #666; }
  .intro { max-width: 780px; color: #444; margin-bottom: 16px; }
  .sub-pills { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 14px; }
  .sub-pill { padding: 4px 11px; border-radius: 20px; background: #fff8ee; border: 1px solid #e8c97a; font-size: 0.78rem; text-decoration: none; color: #7a5c00; font-weight: 500; }
  .sub-pill:hover, .sub-pill.active { background: var(--gold); color: #fff; border-color: var(--gold); }
  .results-count { color: #888; font-size: 0.85rem; margin-bottom: 16px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }
  .pagination {
    display: flex; justify-content: center; align-items: center; gap: 20px;
    margin-top: 36px; font-size: 0.9rem;
  }
  .pagination a { color: var(--gold); font-weight: 600; text-decoration: none; }
  @media (max-width: 480px) {
    .grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
    .pagination { flex-direction: column; gap: 10px; }
    h1 { font-size: 1.4rem; }
  }
</style>
