---
// Pagina DUMO (Infinite Love) a fost scoasă pe 09.11.2026: colecția nu mai are preț pe infinitelove.ro.
// Păstrăm adresa /dumo/ doar ca redirecționare (linkurile din reclame și mesaje vechi nu dau 404).
// Pagina nu se indexează (noindex) și nu intră în sitemap (filtrul din astro.config.mjs).
const TINTA = '/parfumuri/brand/infinite-love/';
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${TINTA}`} />
    <link rel="canonical" href={`https://beauty-healths.com${TINTA}`} />
    <title>Parfumuri Infinite Love</title>
  </head>
  <body>
    <p>Pagina s-a mutat: <a href={TINTA}>parfumuri Infinite Love</a>.</p>
    <script is:inline define:vars={{ TINTA }}>location.replace(TINTA);</script>
  </body>
</html>
