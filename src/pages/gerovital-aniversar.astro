---
// Landing page: Anniversary Shopping Event Gerovital (farmec.ro) — 20 oct 12:00 – 21 oct 23:59, 2026
// Dupa final, pagina ramane online si arata ca oferta s-a incheiat (vezi scriptul de jos).
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import { produse } from '../data/catalog.mjs';

const START = '2026-10-20T12:00:00+03:00';
const END = '2026-10-21T23:59:59+03:00';
const LINK_FARMEC = 'https://event.2performant.com/events/click?ad_type=quicklink&aff_code=676a7e7d9&unique=1dfbc028f&redirect_to=https%253A//www.farmec.ro/';

// Produsele Gerovital din feedul farmec.ro, grupate pe game
const gerovital = produse.filter(
  (p) => p.source_site === 'farmec.ro' && p.availability && /gerovital/i.test(`${p.brand} ${p.title}`)
);
const GRUPE = [
  { id: 'anti-age', titlu: 'Anti-age Gerovital H3', desc: 'Equilibrium, Evolution, Retinol, Hyaluron C, Classic și Luxury — seruri, creme și fiole pentru riduri și fermitate.',
    game: ['Gerovital H3 Equilibrium', 'Gerovital H3 Evolution', 'Gerovital H3 Retinol', 'Gerovital H3 Hyaluron C', 'Gerovital H3 Classic', 'Gerovital Luxury'] },
  { id: 'ten-sensibil', titlu: 'Ten sensibil și cu imperfecțiuni', desc: 'Derma+ pentru roșeață și piele reactivă, Stop Acnee pentru sebum și puncte negre.',
    game: ['Gerovital H3 Derma+', 'Gerovital Stop Acnee'] },
  { id: 'par', titlu: 'Păr — Tratament Expert', desc: 'Șampoane, loțiuni și seruri pentru căderea părului, mătreață și păr degradat.',
    game: ['Gerovital Tratament Expert'] },
  { id: 'machiaj', titlu: 'Machiaj — Gerovital Beauty', desc: 'Mascara, rujuri, anticearcăn și lacuri de unghii.',
    game: ['Gerovital Beauty'] },
  { id: 'barbati', titlu: 'Bărbați — Gerovital Men', desc: 'Ras, îngrijirea tenului, fiole pentru păr și deodorante.',
    game: ['Gerovital Men'] },
  { id: 'deodorante', titlu: 'Deodorante și antiperspirante H3', desc: 'Protecție 48h, fără alcool.',
    game: ['Gerovital H3 Antiperspirante', ''] },
];
const grupe = GRUPE.map((g) => ({
  ...g,
  produse: gerovital
    .filter((p) => g.game.includes((p.brand || '').trim()))
    .sort((a, b) => b.price - a.price),
})).filter((g) => g.produse.length);
const nrProduse = grupe.reduce((s, g) => s + g.produse.length, 0);
const nrGame = new Set(gerovital.map((p) => (p.brand || '').trim()).filter(Boolean)).size;

const title = 'Gerovital: până la -40% timp de 36 de ore | Anniversary Shopping Event';
const description = 'Anniversary Shopping Event pe farmec.ro: până la -40% la gamele de top Gerovital, 20 octombrie ora 12:00 – 21 octombrie ora 23:59. Doar 36 de ore.';
---
<Layout title={title} description={description} canonical="https://beauty-healths.com/gerovital-aniversar/" ogImage="/images/og-gerovital-aniversar.jpg">
  <Header />

  <main class="gv">
    <!-- HERO -->
    <section class="gv-hero">
      <div class="gv-wrap">
        <p class="gv-eyebrow" id="gv-eyebrow">Anniversary Shopping Event · farmec.ro</p>
        <h1><span class="gv-pct">-40%</span> 36 de ore la gamele de top Gerovital</h1>
        <p class="gv-lead">
          Marți, <strong>20 octombrie, ora 12:00</strong> — miercuri, <strong>21 octombrie, ora 23:59</strong>.
          Reduceri de până la 40% la cele mai căutate game Gerovital, doar online, pe farmec.ro.
        </p>

        <div class="gv-count" id="gv-count" aria-live="polite">
          <span class="gv-count-lbl" id="gv-count-lbl">Oferta se încheie în</span>
          <div class="gv-count-row">
            <div><b id="gv-h">--</b><small>ore</small></div><i>:</i>
            <div><b id="gv-m">--</b><small>min</small></div><i>:</i>
            <div><b id="gv-s">--</b><small>sec</small></div>
          </div>
        </div>

        <div class="gv-ctas">
          <a class="gv-btn" href={LINK_FARMEC} target="_blank" rel="noopener sponsored" data-gv-cta="hero">Intră pe farmec.ro →</a>
          <a class="gv-btn gv-btn--ghost" href="#game">Vezi gamele</a>
        </div>
      </div>
    </section>

    <!-- HOOK -->
    <section class="gv-wrap gv-hook">
      <h2>Câte creme ai plătit anul acesta la preț întreg?</h2>
      <p>
        De câte ori ai pus un ser bun în coș și l-ai scos la final, pentru că „e cam scump”?
        Câte luni mai sunt până la cadourile de Crăciun? Și dacă 36 de ore ar fi suficiente ca să-ți faci rezerva pentru toată iarna?
      </p>
      <p>
        <strong>{nrProduse} de produse</strong> din <strong>{nrGame} game Gerovital</strong> sunt adunate mai jos, pe categorii,
        ca să alegi în câteva minute, nu în câteva ore. Reducerea se aplică direct pe farmec.ro.
      </p>
    </section>

    <!-- DETALII -->
    <section class="gv-wrap">
      <div class="gv-facts">
        <div><span>Ce?</span><b>Anniversary Shopping Event</b></div>
        <div><span>Cât?</span><b>Până la -40% la gamele de top Gerovital</b></div>
        <div><span>Când?</span><b>20 oct., 12:00 – 21 oct., 23:59 (36 de ore)</b></div>
        <div><span>Unde?</span><b>Online, pe farmec.ro</b></div>
        <div><span>Cine?</span><b>Gerovital, marca dezvoltată pe baza cercetărilor dr. Ana Aslan și produsă de Farmec Cluj-Napoca</b></div>
      </div>
    </section>

    <!-- GAME -->
    <section class="gv-wrap" id="game">
      <h2 class="gv-h2">Alege gama potrivită</h2>
      <nav class="gv-tabs" aria-label="Game Gerovital">
        {grupe.map((g) => <a href={`#${g.id}`}>{g.titlu} <em>{g.produse.length}</em></a>)}
      </nav>
      <p class="gv-note">Reducerea de până la 40% se aplică direct pe farmec.ro, în coș. Apasă pe produs ca să vezi prețul redus.</p>

      {grupe.map((g) => (
        <div class="gv-group" id={g.id}>
          <h3>{g.titlu}</h3>
          <p>{g.desc}</p>
          <div class="gv-grid">
            {g.produse.map((p) => <div class="gv-card"><span class="gv-off">până la -40%</span><ProductCard product={p} /></div>)}
          </div>
        </div>
      ))}
    </section>

    <!-- SFATURI -->
    <section class="gv-wrap gv-tips">
      <h2 class="gv-h2">3 sfaturi ca să prinzi cele mai bune reduceri</h2>
      <ol>
        <li><b>Fă lista acum.</b> Alege produsele de mai sus din timp, ca să nu ratezi ultimele ore ale campaniei.</li>
        <li><b>Verifică prețul tăiat pe farmec.ro.</b> Reducerea diferă de la o gamă la alta, până la 40%.</li>
        <li><b>Gândește-te și la cadouri.</b> Crăciunul e la mai puțin de 10 săptămâni, iar seturile Gerovital sunt un cadou sigur.</li>
      </ol>
    </section>

    <!-- CTA FINAL -->
    <section class="gv-final">
      <div class="gv-wrap">
        <h2 id="gv-final-title">Mai sunt doar câteva ore din cele 36</h2>
        <p>Până la -40% la gamele de top Gerovital, până miercuri, 21 octombrie, ora 23:59.</p>
        <a class="gv-btn" href={LINK_FARMEC} target="_blank" rel="noopener sponsored" data-gv-cta="final" id="gv-final-btn">Mergi la ofertă pe farmec.ro →</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ START, END }}>
  (function () {
    var start = new Date(START), end = new Date(END);
    // Feedul Farmec nu contine preturile campaniei: cat timp campania e activa, nu aratam pretul
    // intreg din catalog pe carduri (ar contrazice titlul), ci eticheta "pana la -40%".
    var acum = new Date();
    if (acum >= start && acum <= end) document.documentElement.classList.add('gv-activ');
    function pad(n) { return String(n).padStart(2, '0'); }
    function tick() {
      var now = new Date();
      if (now > end) {
        // Campania s-a incheiat
        document.getElementById('gv-eyebrow').textContent = 'Campania s-a încheiat pe 21 octombrie, ora 23:59';
        document.getElementById('gv-count').style.display = 'none';
        document.getElementById('gv-final-title').textContent = 'Campania s-a încheiat';
        document.getElementById('gv-final-btn').textContent = 'Vezi ofertele actuale Farmec →';
        document.documentElement.classList.remove('gv-activ');
        var nota = document.querySelector('.gv-note'); if (nota) nota.textContent = 'Prețurile sunt cele din ultima actualizare a catalogului nostru.';
        return false;
      }
      var target = now < start ? start : end;
      document.getElementById('gv-count-lbl').textContent = now < start ? 'Oferta începe în' : 'Oferta se încheie în';
      var diff = target - now;
      var h = Math.floor(diff / 3600000); diff %= 3600000;
      var m = Math.floor(diff / 60000); diff %= 60000;
      document.getElementById('gv-h').textContent = pad(h);
      document.getElementById('gv-m').textContent = pad(m);
      document.getElementById('gv-s').textContent = pad(Math.floor(diff / 1000));
      return true;
    }
    if (tick()) { var t = setInterval(function () { if (!tick()) clearInterval(t); }, 1000); }

    // GA4: clic pe butoanele spre farmec.ro
    document.querySelectorAll('[data-gv-cta]').forEach(function (a) {
      a.addEventListener('click', function () {
        if (typeof gtag === 'function') gtag('event', 'bh_campaign_click', { campaign: 'gerovital-aniversar', position: a.dataset.gvCta });
      });
    });
  })();
</script>

<style>
  .gv { --gv-dark: #2a0f2e; --gv-gold: #d6a84a; --gv-red: #c8102e; }
  .gv-wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }

  .gv-hero { background: radial-gradient(circle at 20% 0%, #4a1a50 0%, var(--gv-dark) 60%); color: #fff; padding: 56px 0 48px; text-align: center; }
  .gv-eyebrow { display: inline-block; font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--gv-gold); border: 1px solid rgba(214,168,74,.5); border-radius: 999px; padding: 6px 14px; margin: 0 0 18px; }
  .gv-hero h1 { font-size: clamp(1.7rem, 4.5vw, 2.8rem); line-height: 1.15; margin: 0 auto 14px; max-width: 820px; }
  .gv-pct { display: block; font-family: Georgia, serif; font-size: clamp(3.2rem, 11vw, 5.5rem); color: var(--gv-gold); line-height: 1; margin-bottom: 6px; }
  .gv-lead { font-size: 1.05rem; color: rgba(255,255,255,.85); max-width: 640px; margin: 0 auto 26px; line-height: 1.55; }
  .gv-count { margin: 0 auto 26px; }
  .gv-count-lbl { display: block; font-size: .78rem; text-transform: uppercase; letter-spacing: .1em; color: rgba(255,255,255,.6); margin-bottom: 8px; }
  .gv-count-row { display: inline-flex; gap: 8px; align-items: center; }
  .gv-count-row div { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12); border-radius: 10px; padding: 10px 14px; min-width: 70px; }
  .gv-count-row b { display: block; font-size: 2rem; font-variant-numeric: tabular-nums; line-height: 1; }
  .gv-count-row small { font-size: .65rem; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.55); }
  .gv-count-row i { font-style: normal; color: rgba(255,255,255,.35); font-size: 1.4rem; }
  .gv-ctas { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .gv-btn { display: inline-block; background: var(--gv-red); color: #fff; font-weight: 700; text-decoration: none; padding: 14px 26px; border-radius: 8px; transition: transform .15s, background .15s; }
  .gv-btn:hover { background: #a50d26; transform: translateY(-2px); }
  .gv-btn--ghost { background: transparent; border: 1px solid rgba(255,255,255,.4); }
  .gv-btn--ghost:hover { background: rgba(255,255,255,.08); }

  .gv-hook { max-width: 760px; padding-top: 44px; padding-bottom: 8px; text-align: center; }
  .gv-hook h2 { color: var(--gv-dark); font-size: 1.6rem; margin: 0 0 12px; }
  .gv-hook p { color: #444; line-height: 1.65; font-size: 1.02rem; }

  .gv-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin: 28px 0 8px; }
  .gv-facts div { background: #faf6ef; border: 1px solid #eadfca; border-radius: 10px; padding: 14px 16px; }
  .gv-facts span { display: block; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #a07a2c; margin-bottom: 4px; }
  .gv-facts b { color: #222; font-size: .95rem; line-height: 1.4; }

  .gv-h2 { color: var(--gv-dark); font-size: 1.5rem; margin: 40px 0 14px; }
  .gv-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .gv-tabs a { background: #fff; border: 1px solid #ddd; border-radius: 999px; padding: 7px 14px; font-size: .85rem; color: #333; text-decoration: none; }
  .gv-tabs a:hover { border-color: var(--gv-gold); color: var(--gv-dark); }
  .gv-tabs em { font-style: normal; color: #999; margin-left: 4px; }
  .gv-note { font-size: .8rem; color: #6b6b6b; margin: 0 0 8px; }
  .gv-group { padding-top: 26px; scroll-margin-top: 80px; }
  .gv-group h3 { color: var(--gv-dark); font-size: 1.2rem; margin: 0 0 4px; }
  .gv-group > p { color: #666; font-size: .92rem; margin: 0 0 14px; }
  .gv-card { position: relative; }
  .gv-off { display: none; position: absolute; top: 10px; left: 10px; z-index: 2; background: #c8102e; color: #fff; font-size: .72rem; font-weight: 800; padding: 4px 8px; border-radius: 6px; letter-spacing: .02em; }
  :global(html.gv-activ) .gv-off { display: block; }
  :global(html.gv-activ) .gv-grid :global(.price-row) { display: none; }
  .gv-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; }

  .gv-tips ol { padding-left: 20px; line-height: 1.7; color: #333; max-width: 760px; }
  .gv-final { background: var(--gv-dark); color: #fff; text-align: center; padding: 44px 0; margin-top: 48px; }
  .gv-final h2 { margin: 0 0 8px; font-size: 1.6rem; }
  .gv-final p { color: rgba(255,255,255,.8); margin: 0 0 20px; }

  @media (max-width: 520px) {
    .gv-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .gv-count-row div { min-width: 58px; padding: 8px 10px; }
    .gv-count-row b { font-size: 1.6rem; }
  }
</style>
