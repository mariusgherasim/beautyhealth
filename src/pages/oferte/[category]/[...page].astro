---
import Layout from '../../../layouts/Layout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import BannerSlot from '../../../components/BannerSlot.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Newsletter from '../../../components/Newsletter.astro';
import productsData from '../../../data/products.json';
import { categories, getCategoryBySlug } from '../../../data/categories.js';

export function getStaticPaths({ paginate }) {
  const PAGE_SIZE = 24;

  return categories.flatMap((cat) => {
    const products = productsData
      .filter((p) =>
        !p.draft && p.availability &&
        p.old_price && p.old_price > p.price &&
        p.category.includes(cat.slug)
      )
      .map((p) => ({
        ...p,
        _pct: Math.round((1 - p.price / p.old_price) * 100),
        _sum: Math.round(p.old_price - p.price),
      }))
      .sort((a, b) => b._pct - a._pct);

    if (products.length === 0) return [];

    return paginate(products, {
      params: { category: cat.slug },
      pageSize: PAGE_SIZE,
    });
  });
}

const { page } = Astro.props;
const { category: categorySlug } = Astro.params;
const cat = getCategoryBySlug(categorySlug);

const canonicalBase = `https://beautyhealth.gherasimmarius.com/oferte/${categorySlug}/`;
const canonical = page.currentPage === 1
  ? canonicalBase
  : `${canonicalBase}${page.currentPage}/`;

const title = page.currentPage === 1
  ? `Oferte ${cat.name} — Cele mai mari reduceri | BeautyHealth`
  : `Oferte ${cat.name} — Pagina ${page.currentPage} | BeautyHealth`;
---

<Layout title={title} description={`${page.total} produse ${cat.name} cu reducere, sortate după cel mai mare discount.`} canonical={canonical}>
  <Fragment slot="head">
    {page.currentPage > 1 && (
      <link rel="prev" href={page.currentPage === 2 ? canonicalBase : `${canonicalBase}${page.currentPage - 1}/`} />
    )}
    {page.url.next && (
      <link rel="next" href={`https://beautyhealth.gherasimmarius.com${page.url.next}`} />
    )}
  </Fragment>

  <Header />

  <main class="wrap">
    <nav class="breadcrumbs" aria-label="breadcrumb">
      <a href="/">Acasă</a> <span>/</span>
      <a href="/oferte/">Oferte</a> <span>/</span>
      <span>{cat.name}</span>
    </nav>

    <BannerSlot category={categorySlug} size="728x90" />

    <h1>🏷️ Oferte {cat.name}</h1>
    {page.currentPage === 1 && (
      <p class="intro">
        Cele mai mari reduceri din categoria {cat.name}, sortate după procentul de discount.
      </p>
    )}

    <!-- Filtre pe categorii -->
    <div class="nav-row">
      <span class="nav-label">Categorii</span>
      <div class="category-pills">
        <a href="/oferte/" class="cat-pill">Toate</a>
        {categories.map((c) => (
          <a href={`/oferte/${c.slug}/`} class={c.slug === categorySlug ? 'cat-pill active' : 'cat-pill'}>{c.name}</a>
        ))}
      </div>
    </div>

    <p class="results-count">
      {page.total} produse cu reducere — pagina {page.currentPage} din {page.lastPage}
    </p>

    <div class="grid">
      {page.data.map((product) => (
        <div class="card-wrap">
          <div class="discount-badge">-{product._pct}%</div>
          <ProductCard product={product} />
        </div>
      ))}
    </div>

    <nav class="pagination" aria-label="paginare">
      {page.url.prev && <a href={page.url.prev}>← Pagina anterioară</a>}
      <span>Pagina {page.currentPage} / {page.lastPage}</span>
      {page.url.next && <a href={page.url.next}>Pagina următoare →</a>}
    </nav>

    <BannerSlot category={categorySlug} />
    <Newsletter />
  </main>

  <Footer />
</Layout>

<style>
  .wrap { max-width: 1200px; margin: 0 auto; padding: 20px 16px 60px; }
  .breadcrumbs { font-size: 0.85rem; color: #888; margin-bottom: 12px; }
  .breadcrumbs a { color: #888; text-decoration: none; }
  h1 { color: var(--navy); margin-bottom: 8px; font-size: 1.8rem; }
  .intro { max-width: 780px; color: #444; margin-bottom: 16px; }
  .nav-row { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
  .nav-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: #aaa; font-weight: 700; padding-top: 7px; white-space: nowrap; min-width: 52px; }
  .category-pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .cat-pill { padding: 6px 13px; border-radius: 20px; background: #fff; border: 1px solid #ddd; font-size: 0.85rem; text-decoration: none; color: var(--navy); transition: background 0.15s; }
  .cat-pill:hover { border-color: var(--navy); }
  .cat-pill.active { background: var(--navy); color: #fff; border-color: var(--navy); }
  .results-count { color: #888; font-size: 0.85rem; margin-bottom: 16px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; }
  .card-wrap { position: relative; }
  .discount-badge { position: absolute; top: 8px; left: 8px; z-index: 2; background: #b94040; color: white; font-size: 0.78rem; font-weight: 800; padding: 4px 10px; border-radius: 20px; pointer-events: none; }
  .pagination { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 36px; font-size: 0.9rem; }
  .pagination a { color: var(--gold); font-weight: 600; text-decoration: none; }
  @media (max-width: 600px) {
    .grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
    .pagination { flex-direction: column; gap: 10px; }
    h1 { font-size: 1.4rem; }
  }
</style>
