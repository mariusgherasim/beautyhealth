---
// Pagina /promotii/ — oferte si coduri de reducere de la magazinele partenere.
// Datele: src/data/promotii.js. Ofertele expirate dispar singure (si la build, si in browser).
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { promotii } from '../data/promotii.js';
import { categories } from '../data/categories.js';

const azi = new Date().toISOString().slice(0, 10);
// toate cele neexpirate ajung în pagină (și cele programate, ascunse până în ziua lor);
// textele și numerele se calculează doar pe cele vizibile azi, iar browserul le actualizează
const active = promotii.filter((p) => !p.expira || p.expira >= azi);
const vizibile = active.filter((p) => !p.incepe || p.incepe <= azi);
const magazine = [...new Set(active.map((p) => p.magazin))];
const magVizibile = [...new Set(vizibile.map((p) => p.magazin))];
const numeCat = Object.fromEntries(categories.map((c) => [c.slug, c.name]));
const fmtData = (d) => new Date(d + 'T12:00:00').toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' });
const ascunde = (cod) => cod.length <= 3 ? '•••' : '•'.repeat(Math.max(2, cod.length - 2)) + cod.slice(-2);

const title = 'Promoții și coduri de reducere — Dr. Max, Farmec, DetoxMed, Longevity BOOST | BeautyHealth';
const description = `${vizibile.length} promoții active la magazinele de frumusețe și sănătate: ${magVizibile.join(', ')}. Verificate și actualizate, cu data de expirare.`;
---
<Layout title={title} description={description} canonical="https://beauty-healths.com/promotii/">
  <Header />

  <main class="pr">
    <section class="pr-hero">
      <div class="pr-wrap">
        <p class="pr-eyebrow">Actualizat {fmtData(azi)}</p>
        <h1>Promoții și coduri de reducere</h1>
        <p class="pr-lead">
          <strong><span id="pr-nr">{vizibile.length}</span> oferte active</strong> de la <span id="pr-nrmag">{magVizibile.length}</span> magazine: <span id="pr-mags">{magVizibile.join(', ')}</span>.
          Le verificăm pe site-ul magazinului și le scoatem singure când expiră.
        </p>
      </div>
    </section>

    <section class="pr-wrap">
      <div class="pr-chips" role="group" aria-label="Filtrează după magazin">
        <button type="button" class="pr-chip is-on" data-mag="">Toate ({active.length})</button>
        {magazine.map((m) => <button type="button" class="pr-chip" data-mag={m}>{m} ({active.filter((p) => p.magazin === m).length})</button>)}
      </div>

      <div class="pr-grid">
        {active.map((p) => (
          <article class="pr-card" data-mag={p.magazin} data-expira={p.expira || ''} data-incepe={p.incepe || ''} id={p.id} hidden={p.incepe && p.incepe > azi ? true : undefined}>
            <div class="pr-top">
              <div>
                <span class="pr-mag">{p.magazin}</span>
                <span class="pr-dom">{p.domeniu}</span>
              </div>
              {p.reducere && <span class="pr-badge">{p.reducere}</span>}
            </div>
            <h2>{p.titlu}</h2>
            <p class="pr-desc">{p.descriere}</p>
            <div class="pr-meta">
              <span class="pr-ok">✓ Verificat {fmtData(p.verificat)}</span>
              <span class="pr-exp">{p.expira ? `Expiră: ${fmtData(p.expira)}` : 'Fără dată de expirare anunțată'}</span>
              {p.categorii.length > 0 && <span class="pr-cats">{p.categorii.map((c) => numeCat[c]).filter(Boolean).join(' · ')}</span>}
            </div>
            <div class="pr-actions">
              {p.cod && (
                <div class="pr-codzone">
                  {p.cod_text && <p class="pr-codtext">🎟️ {p.cod_text}</p>}
                  <button type="button" class="pr-btn pr-btn--cod" data-cod={p.cod} data-titlu={p.cod_text || p.titlu} data-magazin={p.magazin} data-id={p.id}>
                    <span class="pr-cod-ascuns">{ascunde(p.cod)}</span>
                    <span class="pr-cod-lbl">Afișează codul</span>
                  </button>
                </div>
              )}
              <a class="pr-btn" href={p.link} target="_blank" rel="noopener sponsored nofollow" data-pr-click={p.id}>Vezi oferta →</a>
            </div>
          </article>
        ))}
      </div>
      {active.length === 0 && <p class="pr-gol">Momentan nu avem promoții active. Revino curând!</p>}
      <p class="pr-note">Linkurile duc pe site-urile magazinelor și sunt linkuri de afiliere: dacă cumperi, putem primi un comision, fără niciun cost în plus pentru tine. Condițiile exacte ale fiecărei oferte le găsești pe site-ul magazinului.</p>
    </section>

    <!-- Fereastra pentru coduri de reducere -->
    <div class="pr-modal" id="pr-modal" hidden>
      <div class="pr-dialog" role="dialog" aria-modal="true" aria-labelledby="pr-m-titlu">
        <button type="button" class="pr-close" id="pr-close" aria-label="Închide">×</button>
        <h2 id="pr-m-titlu"></h2>
        <div class="pr-codebox">
          <div class="pr-code" id="pr-m-cod"></div>
          <button type="button" class="pr-copy" id="pr-m-copy">Copiază codul</button>
        </div>
        <p class="pr-copied" id="pr-m-msg" aria-live="polite"></p>
        <p class="pr-m-desc" id="pr-m-desc"></p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  (function () {
    // ascunde ofertele expirate de la ultimul build incoace
    var azi = new Date(Date.now() + 2 * 3600e3).toISOString().slice(0, 10); // ora României
    // și pe cele care încă n-au început (câmpul incepe) — apar singure în ziua lor
    document.querySelectorAll('.pr-card').forEach(function (c) {
      if ((c.dataset.expira && c.dataset.expira < azi) || (c.dataset.incepe && c.dataset.incepe > azi)) c.remove();
      else c.hidden = false;
    });
    // numerele de pe butoanele de filtrare, după ce am scos ofertele care nu se văd azi
    document.querySelectorAll('.pr-chip').forEach(function (ch) {
      var n = document.querySelectorAll(ch.dataset.mag ? '.pr-card[data-mag="' + ch.dataset.mag + '"]' : '.pr-card').length;
      if (!n && ch.dataset.mag) { ch.remove(); return; }
      ch.textContent = ch.textContent.replace(/\(\d+\)/, '(' + n + ')');
    });
    var mags = [];
    document.querySelectorAll('.pr-card').forEach(function (c) { if (mags.indexOf(c.dataset.mag) < 0) mags.push(c.dataset.mag); });
    var setT = function (id, v) { var x = document.getElementById(id); if (x) x.textContent = v; };
    setT('pr-nr', document.querySelectorAll('.pr-card').length); setT('pr-nrmag', mags.length); setT('pr-mags', mags.join(', '));

    // filtre pe magazin
    var chips = document.querySelectorAll('.pr-chip');
    chips.forEach(function (ch) {
      ch.addEventListener('click', function () {
        chips.forEach(function (x) { x.classList.toggle('is-on', x === ch); });
        document.querySelectorAll('.pr-card').forEach(function (c) { c.hidden = !!ch.dataset.mag && c.dataset.mag !== ch.dataset.mag; });
      });
    });

    var ga = function (ev, p) { if (typeof gtag === 'function') gtag('event', ev, p); };
    document.querySelectorAll('[data-pr-click]').forEach(function (a) {
      a.addEventListener('click', function () { ga('bh_promo_click', { promo: a.dataset.prClick }); });
    });

    // coduri: Afiseaza codul -> fereastra cu codul -> Copiaza codul -> inapoi la card -> Vezi oferta
    var modal = document.getElementById('pr-modal');
    var curent = null;
    function inchide() {
      modal.hidden = true;
      if (curent) {
        var card = curent.closest('.pr-card');
        card.classList.add('is-copiat');
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        var v = card.querySelector('a.pr-btn'); if (v) v.focus({ preventScroll: true });
      }
    }
    function arata(b) {
      curent = b;
      document.getElementById('pr-m-titlu').textContent = b.dataset.titlu;
      document.getElementById('pr-m-cod').textContent = b.dataset.cod;
      document.getElementById('pr-m-desc').textContent = 'Apasă „Copiază codul”, apoi „Vezi oferta” și lipește codul în coș, la „Cod de reducere”, pe site-ul ' + b.dataset.magazin + '.';
      document.getElementById('pr-m-msg').textContent = '';
      var btn = document.getElementById('pr-m-copy');
      btn.textContent = 'Copiază codul';
      modal.hidden = false;
      btn.focus();
      btn.onclick = function () {
        var cod = b.dataset.cod;
        var gata = function () {
          btn.textContent = 'Copiat ✓';
          document.getElementById('pr-m-msg').textContent = 'Codul ' + cod + ' a fost copiat.';
          // codul ramane afisat pe card, ca sa-l vada si dupa
          b.querySelector('.pr-cod-ascuns').textContent = cod;
          b.querySelector('.pr-cod-lbl').textContent = 'Copiază din nou';
          ga('bh_promo_code_copy', { promo: b.dataset.id });
          setTimeout(inchide, 900);
        };
        if (navigator.clipboard) navigator.clipboard.writeText(cod).then(gata, function () { document.getElementById('pr-m-msg').textContent = 'Selectează codul și copiază-l manual.'; });
        else document.getElementById('pr-m-msg').textContent = 'Selectează codul și copiază-l manual.';
      };
    }
    document.querySelectorAll('.pr-btn--cod').forEach(function (b) {
      b.addEventListener('click', function () { arata(b); ga('bh_promo_code', { promo: b.dataset.id }); });
    });
    document.getElementById('pr-close').addEventListener('click', inchide);
    modal.addEventListener('click', function (e) { if (e.target === modal) inchide(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') inchide(); });

    // link direct la o oferta: /promotii/#id
    if (location.hash) { var t = document.getElementById(location.hash.slice(1)); if (t) t.classList.add('is-target'); }
  })();
</script>

<style>
  .pr { --pr-navy: #0B1F4A; --pr-red: #c8102e; --pr-gold: #C89B3C; }
  .pr-wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  .pr-hero { background: linear-gradient(135deg, var(--pr-navy), #14306e); color: #fff; padding: 44px 0 36px; text-align: center; }
  .pr-eyebrow { font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--pr-gold); margin: 0 0 10px; font-weight: 700; }
  .pr-hero h1 { margin: 0 0 10px; font-size: clamp(1.7rem, 4vw, 2.4rem); }
  .pr-lead { color: rgba(255,255,255,.85); max-width: 680px; margin: 0 auto; line-height: 1.55; }

  .pr-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 26px 0 18px; }
  .pr-chip { background: #fff; border: 1px solid #ddd; border-radius: 999px; padding: 8px 14px; cursor: pointer; font-size: .9rem; }
  .pr-chip.is-on { background: var(--pr-navy); color: #fff; border-color: var(--pr-navy); }

  .pr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 16px; }
  .pr-card { background: #fff; border: 1px solid #e3e3e8; border-radius: 14px; padding: 18px; display: flex; flex-direction: column; gap: 8px; scroll-margin-top: 90px; }
  .pr-card[hidden] { display: none; }
  .pr-card.is-target { box-shadow: 0 0 0 2px var(--pr-gold); }
  .pr-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .pr-mag { display: block; font-weight: 800; color: var(--pr-navy); font-size: 1.05rem; }
  .pr-dom { font-size: .78rem; color: #6b6b6b; }
  .pr-badge { background: var(--pr-red); color: #fff; font-weight: 900; font-size: 1.15rem; padding: 6px 10px; border-radius: 8px; white-space: nowrap; }
  .pr-card h2 { font-size: 1.08rem; margin: 4px 0 0; color: #222; line-height: 1.35; }
  .pr-desc { color: #555; font-size: .93rem; line-height: 1.5; margin: 0; }
  .pr-meta { display: flex; flex-direction: column; gap: 2px; font-size: .8rem; color: #777; }
  .pr-ok { color: #1f8a4c; font-weight: 600; }
  .pr-actions { margin-top: auto; padding-top: 8px; }
  .pr-btn { display: block; text-align: center; background: var(--pr-red); color: #fff; font-weight: 700; text-decoration: none; padding: 12px 16px; border-radius: 8px; border: 0; width: 100%; cursor: pointer; font-size: .95rem; }
  .pr-btn:hover { background: #a50d26; }
  .pr-actions { display: flex; flex-direction: column; gap: 10px; }
  .pr-codzone { background: #fdf8ee; border-radius: 10px; padding: 10px; }
  .pr-codtext { margin: 0 0 8px; font-size: .88rem; font-weight: 700; color: #7a5a16; text-align: center; }
  .pr-btn--cod { background: #fff; color: var(--pr-navy); border: 2px dashed var(--pr-gold); display: flex; align-items: center; justify-content: center; }
  .pr-card.is-copiat .pr-btn--cod { border-style: solid; border-color: #1f8a4c; }
  .pr-card.is-copiat a.pr-btn { box-shadow: 0 0 0 3px rgba(200,16,46,.25); }
  .pr-btn--cod:hover { background: #fdf8ee; }
  .pr-cod-ascuns { font-family: ui-monospace, monospace; font-weight: 800; letter-spacing: .1em; margin-right: 10px; color: var(--pr-navy); }
  .pr-gol { text-align: center; color: #666; padding: 40px 0; }
  .pr-note { font-size: .8rem; color: #6b6b6b; margin: 22px 0 40px; line-height: 1.5; }

  .pr-modal { position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 10002; display: flex; align-items: center; justify-content: center; padding: 16px; }
  .pr-modal[hidden] { display: none; }
  .pr-dialog { position: relative; background: #fff; border-radius: 14px; max-width: 460px; width: 100%; padding: 26px 22px 20px; text-align: center; }
  .pr-dialog h2 { font-size: 1.15rem; margin: 0 24px 16px; color: #222; }
  .pr-close { position: absolute; top: 8px; right: 10px; border: 0; background: none; font-size: 1.6rem; cursor: pointer; color: #666; }
  .pr-codebox { display: flex; border: 2px dashed var(--pr-gold); border-radius: 10px; overflow: hidden; }
  .pr-code { flex: 1; font-family: ui-monospace, monospace; font-size: 1.4rem; font-weight: 800; letter-spacing: .08em; padding: 12px; color: var(--pr-navy); user-select: all; }
  .pr-copy { border: 0; background: var(--pr-navy); color: #fff; font-weight: 700; padding: 0 16px; cursor: pointer; }
  .pr-copied { min-height: 1.2em; color: #1f8a4c; font-size: .85rem; margin: 8px 0 12px; }
  .pr-m-desc { color: #666; font-size: .88rem; margin: 14px 0 0; line-height: 1.5; }
</style>
